<?xml version="1.0" ?>
<type name="popover_item" xmlns="http://schemas.sulu.io/template/template"
      xmlns:xi="http://www.w3.org/2001/XInclude">
    <meta>
        <title lang="en">Hotspot Marker</title>
        <title lang="tr">İnteraktif Nokta (Hotspot)</title>
        <title lang="de">Hotspot-Markierung</title>
        <title lang="ru">Точка на изображении</title>
        <title lang="es">Marcador interactivo</title>
        <title lang="fr">Marqueur interactif</title>
    </meta>
    <properties>
        <property name="hotspot" type="hotspot_picker" colspan="12">
            <meta>
                <title lang="en">Marker Position</title>
                <title lang="tr">İşaretçi Konumu</title>
            </meta>
        </property>

        <property name="marker_type" type="single_select" colspan="6">
            <meta>
                <title lang="en">Marker Style</title>
                <title lang="tr">İşaretçi Stili</title>
            </meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit">
                        <meta>
                            <title lang="en">Inherit from Block</title>
                            <title lang="tr">Blok Ayarını Kullan</title>
                            <title lang="de">Aus Block übernehmen</title>
                        </meta>
                    </param>
                    <param name="pulse">
                        <meta>
                            <title lang="en">Radar Pulse</title>
                            <title lang="tr">Radar (Pulse)</title>
                        </meta>
                    </param>
                    <param name="plus">
                        <meta>
                            <title lang="en">Plus (+)</title>
                            <title lang="tr">Artı (+)</title>
                        </meta>
                    </param>
                    <param name="number">
                        <meta>
                            <title lang="en">Number (1, 2, 3...)</title>
                            <title lang="tr">Numara (1, 2, 3...)</title>
                        </meta>
                    </param>
                    <param name="dot">
                        <meta>
                            <title lang="en">Solid Dot</title>
                            <title lang="tr">Nokta (Dot)</title>
                        </meta>
                    </param>
                    <param name="pin">
                        <meta>
                            <title lang="en">Map Pin</title>
                            <title lang="tr">Harita İğnesi</title>
                        </meta>
                    </param>
                    <param name="icon">
                        <meta>
                            <title lang="en">Custom Icon</title>
                            <title lang="tr">Özel İkon</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="marker_color" type="single_select" colspan="6">
            <meta>
                <title lang="en">Marker Color</title>
                <title lang="tr">İşaretçi Rengi</title>
            </meta>
            <params>
                <param name="default_value" value="inherit"/>
                <param name="values" type="collection">
                    <param name="inherit">
                        <meta>
                            <title lang="en">Inherit from Block</title>
                            <title lang="tr">Blok Ayarını Kullan</title>
                            <title lang="de">Aus Block übernehmen</title>
                        </meta>
                    </param>
                    <param name="primary">
                        <meta>
                            <title lang="en">Primary (Blue)</title>
                            <title lang="tr">Birincil (Mavi)</title>
                        </meta>
                    </param>
                    <param name="dark">
                        <meta>
                            <title lang="en">Dark Neutral</title>
                            <title lang="tr">Koyu Gri</title>
                        </meta>
                    </param>
                    <param name="light">
                        <meta>
                            <title lang="en">Light (White)</title>
                            <title lang="tr">Açık / Beyaz</title>
                        </meta>
                    </param>
                    <param name="accent">
                        <meta>
                            <title lang="en">Accent (Amber)</title>
                            <title lang="tr">Sarı / Vurgu</title>
                        </meta>
                    </param>
                    <param name="success">
                        <meta>
                            <title lang="en">Success (Green)</title>
                            <title lang="tr">Yeşil</title>
                        </meta>
                    </param>
                    <param name="danger">
                        <meta>
                            <title lang="en">Danger (Red)</title>
                            <title lang="tr">Kırmızı</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="icon" type="single_icon_selection" colspan="12" visibleCondition="marker_type == 'icon'">
            <meta>
                <title lang="en">Custom Marker Icon</title>
                <title lang="tr">Özel İşaretçi İkonu</title>
                <title lang="de">Eigenes Markierungssymbol</title>
                <title lang="ru">Пользовательская иконка</title>
                <title lang="es">Icono personalizado</title>
                <title lang="fr">Icône personnalisée</title>
            </meta>
            <params>
                <param name="icon_set" value="tabler"/>
            </params>
        </property>
        <xi:include href="../fields/title.xml"/>

        <property name="meta" type="text_line">
            <meta>
                <title lang="en">Subtitle / Meta (e.g. Price, Category)</title>
                <title lang="tr">Alt Başlık / Meta Bilgisi (Örn: Fiyat, Kategori)</title>
            </meta>
        </property>

        <xi:include href="../fields/content.xml"/>

        <property name="image" type="single_media_selection">
            <meta>
                <title lang="en">Card Media / Image</title>
                <title lang="tr">Kart Görseli</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="video" type="single_media_selection">
            <meta>
                <title lang="en">Card Video</title>
                <title lang="tr">Kart Videosu</title>
            </meta>
            <params>
                <param name="types" value="video"/>
            </params>
        </property>

        <xi:include href="../fields/badge.xml"/>
        <xi:include href="../fields/link.xml"/>
        <xi:include href="../fields/link_title.xml"/>
    </properties>
</type>
