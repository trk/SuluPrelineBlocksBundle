<?xml version="1.0" ?>
<!--
    Shared media display settings (aspect ratio, custom ratio, fit mode).
    No default values: the rendering component defines the default, so each block keeps
    its own sensible default while the editor options stay identical everywhere.
-->
<properties xmlns="http://schemas.sulu.io/template/template">
    <property name="aspect_ratio" type="single_select" colspan="6">
        <meta>
            <title lang="en">Aspect Ratio</title>
            <title lang="tr">En / Boy Oranı</title>
            <title lang="de">Seitenverhältnis</title>
            <title lang="ru">Соотношение сторон</title>
            <title lang="es">Relación de Aspecto</title>
            <title lang="fr">Rapport d&apos;Aspect</title>
        </meta>
        <params>
            <param name="values" type="collection">
                <param name="auto">
                    <meta>
                        <title lang="en">Auto</title>
                        <title lang="tr">Otomatik</title>
                        <title lang="de">Automatisch</title>
                        <title lang="ru">Авто</title>
                        <title lang="es">Automático</title>
                        <title lang="fr">Auto</title>
                    </meta>
                </param>
                <param name="16/9">
                    <meta>
                        <title lang="en">16:9 Widescreen</title>
                        <title lang="tr">16:9 Geniş Ekran</title>
                        <title lang="de">16:9 Breitbild</title>
                        <title lang="ru">16:9 Широкоэкранный</title>
                        <title lang="es">16:9 Panorámico</title>
                        <title lang="fr">16:9 Écran Large</title>
                    </meta>
                </param>
                <param name="4/3">
                    <meta>
                        <title lang="en">4:3 Standard</title>
                        <title lang="tr">4:3 Standart</title>
                        <title lang="de">4:3 Standard</title>
                        <title lang="ru">4:3 Стандартный</title>
                        <title lang="es">4:3 Estándar</title>
                        <title lang="fr">4:3 Standard</title>
                    </meta>
                </param>
                <param name="1/1">
                    <meta>
                        <title lang="en">1:1 Square</title>
                        <title lang="tr">1:1 Kare</title>
                        <title lang="de">1:1 Quadratisch</title>
                        <title lang="ru">1:1 Квадрат</title>
                        <title lang="es">1:1 Cuadrado</title>
                        <title lang="fr">1:1 Carré</title>
                    </meta>
                </param>
                <param name="9/16">
                    <meta>
                        <title lang="en">9:16 Portrait</title>
                        <title lang="tr">9:16 Dikey</title>
                        <title lang="de">9:16 Hochformat</title>
                        <title lang="ru">9:16 Портретный</title>
                        <title lang="es">9:16 Retrato</title>
                        <title lang="fr">9:16 Portrait</title>
                    </meta>
                </param>
                <param name="21/9">
                    <meta>
                        <title lang="en">21:9 Ultrawide</title>
                        <title lang="tr">21:9 Ultra Geniş</title>
                        <title lang="de">21:9 Ultrabreit</title>
                        <title lang="ru">21:9 Ультраширокий</title>
                        <title lang="es">21:9 Ultra Panorámico</title>
                        <title lang="fr">21:9 Ultra Large</title>
                    </meta>
                </param>
                <param name="manual">
                    <meta>
                        <title lang="en">Manual</title>
                        <title lang="tr">Özel Oran</title>
                        <title lang="de">Manuell</title>
                        <title lang="ru">Вручную</title>
                        <title lang="es">Manual</title>
                        <title lang="fr">Manuel</title>
                    </meta>
                </param>
            </param>
        </params>
    </property>
    <property name="aspect_ratio_width" type="number" colspan="6" visibleCondition="aspect_ratio == 'manual'">
      <meta>
        <title lang="en">Width Ratio</title>
        <title lang="tr">Genişlik Oranı</title>
        <title lang="de">Breitenverhältnis</title>
        <title lang="ru">Соотношение ширины</title>
        <title lang="es">Proporción de ancho</title>
        <title lang="fr">Rapport de largeur</title>
        <info_text lang="en">E.g. 16, 4, 21 or custom pixel width ratio</info_text>
        <info_text lang="tr">&#xD6;rn: 16, 4, 21 veya &#xF6;zel oran geni&#x15F;lik de&#x11F;eri</info_text>
        <info_text lang="de">Z. B. 16, 4, 21 oder benutzerdefiniertes Breitenverh&#xE4;ltnis</info_text>
        <info_text lang="ru">&#x41D;&#x430;&#x43F;&#x440;.: 16, 4, 21 &#x438;&#x43B;&#x438; &#x43F;&#x43E;&#x43B;&#x44C;&#x437;&#x43E;&#x432;&#x430;&#x442;&#x435;&#x43B;&#x44C;&#x441;&#x43A;&#x43E;&#x435; &#x441;&#x43E;&#x43E;&#x442;&#x43D;&#x43E;&#x448;&#x435;&#x43D;&#x438;&#x435; &#x448;&#x438;&#x440;&#x438;&#x43D;&#x44B;</info_text>
        <info_text lang="es">Ej. 16, 4, 21 o proporci&#xF3;n de ancho personalizada</info_text>
        <info_text lang="fr">Ex. 16, 4, 21 ou ratio de largeur personnalis&#xE9;</info_text>
      </meta>
      <params>
        <param name="min" value="1"/>
        <param name="step" value="1"/>
      </params>
    </property>
    <property name="aspect_ratio_height" type="number" colspan="6" visibleCondition="aspect_ratio == 'manual'">
      <meta>
        <title lang="en">Height Ratio</title>
        <title lang="tr">Yükseklik Oranı</title>
        <title lang="de">Höhenverhältnis</title>
        <title lang="ru">Соотношение высоты</title>
        <title lang="es">Proporción de altura</title>
        <title lang="fr">Rapport de hauteur</title>
        <info_text lang="en">E.g. 9, 3, 10 or custom pixel height ratio</info_text>
        <info_text lang="tr">&#xD6;rn: 9, 3, 10 veya &#xF6;zel oran y&#xFC;kseklik de&#x11F;eri</info_text>
        <info_text lang="de">Z. B. 9, 3, 10 oder benutzerdefiniertes H&#xF6;henverh&#xE4;ltnis</info_text>
        <info_text lang="ru">&#x41D;&#x430;&#x43F;&#x440;.: 9, 3, 10 &#x438;&#x43B;&#x438; &#x43F;&#x43E;&#x43B;&#x44C;&#x437;&#x43E;&#x432;&#x430;&#x442;&#x435;&#x43B;&#x44C;&#x441;&#x43A;&#x43E;&#x435; &#x441;&#x43E;&#x43E;&#x442;&#x43D;&#x43E;&#x448;&#x435;&#x43D;&#x438;&#x435; &#x432;&#x44B;&#x441;&#x43E;&#x442;&#x44B;</info_text>
        <info_text lang="es">Ej. 9, 3, 10 o proporci&#xF3;n de alto personalizada</info_text>
        <info_text lang="fr">Ex. 9, 3, 10 ou ratio de hauteur personnalis&#xE9;</info_text>
      </meta>
      <params>
        <param name="min" value="1"/>
        <param name="step" value="1"/>
      </params>
    </property>
    <property name="object_fit" type="single_select" colspan="6" visibleCondition="aspect_ratio != 'auto'">
      <meta>
        <title lang="en">Fit Mode</title>
        <title lang="tr">S&#x131;&#x11F;d&#x131;rma Modu</title>
        <title lang="de">Anpassungsmodus</title>
        <title lang="ru">&#x420;&#x435;&#x436;&#x438;&#x43C; &#x43F;&#x43E;&#x434;&#x433;&#x43E;&#x43D;&#x43A;&#x438;</title>
        <title lang="es">Modo de ajuste</title>
        <title lang="fr">Mode d'ajustement</title>
      </meta>
      <params>
        <param name="values" type="collection">
          <param name="cover">
            <meta>
              <title lang="en">Cover</title>
              <title lang="tr">Kırp ve Doldur</title>
              <title lang="de">Ausfüllen</title>
              <title lang="ru">Заполнить с обрезкой</title>
              <title lang="es">Cubrir</title>
              <title lang="fr">Couvrir</title>
            </meta>
          </param>
          <param name="contain">
            <meta>
              <title lang="en">Contain</title>
              <title lang="tr">İçine Sığdır</title>
              <title lang="de">Einpassen</title>
              <title lang="ru">Вписать целиком</title>
              <title lang="es">Contener</title>
              <title lang="fr">Contenir</title>
            </meta>
          </param>
          <param name="fill">
            <meta>
              <title lang="en">Fill</title>
              <title lang="tr">Doldur / Uzat</title>
              <title lang="de">Strecken</title>
              <title lang="ru">Растянуть</title>
              <title lang="es">Estirar</title>
              <title lang="fr">Étirer</title>
            </meta>
          </param>
        </param>
      </params>
    </property>
</properties>
