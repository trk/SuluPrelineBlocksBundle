<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>section</key>
    <meta>
        <title lang="en">Section</title>
        <title lang="tr">Bölüm</title>
        <title lang="de">Abschnitt</title>
        <title lang="ru">Раздел</title>
        <title lang="es">Sección</title>
        <title lang="fr">Section</title>
    </meta>
    <tag name="sulu_block_suite.tabs" exclude="dynamic_content"/>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <block name="rows" default-type="row_item" minOccurs="1">
                    <meta>
                        <title lang="en">Rows</title>
                        <title lang="tr">Satırlar</title>
                        <title lang="de">Zeilen</title>
                        <title lang="ru">Строки</title>
                        <title lang="es">Filas</title>
                        <title lang="fr">Lignes</title>
                    </meta>
                    <tag name="sulu_block_suite.tabs" shared="true" exclude="dynamic_content"/>
                    <types>
                        <xi:include href="../block-items/row_item.xml"/>
                    </types>
                </block>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <property name="max_width" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Container Max Width</title>
                        <title lang="tr">Konteyner Azami Genişliği</title>
                        <title lang="de">Maximale Container-Breite</title>
                        <title lang="ru">Максимальная ширина контейнера</title>
                        <title lang="es">Ancho Máximo del Contenedor</title>
                        <title lang="fr">Largeur Maximale du Contenedor</title>
                    </meta>
                    <params>
                        <param name="default_value" value="85rem"/>
                        <param name="values" type="collection">
                            <param name="85rem">
                                <meta>
                                    <title lang="en">Preline Standard (85rem)</title>
                                    <title lang="tr">Preline Standart (85rem)</title>
                                    <title lang="de">Preline Standard (85rem)</title>
                                    <title lang="ru">Стандарт Preline (85rem)</title>
                                    <title lang="es">Estándar Preline (85rem)</title>
                                    <title lang="fr">Standard Preline (85rem)</title>
                                </meta>
                            </param>
                            <param name="container">
                                <meta>
                                    <title lang="en">Preline Container (Breakpoint Based)</title>
                                    <title lang="tr">Preline Konteyner (Breakpoint Bazlı)</title>
                                    <title lang="de">Preline Container (Breakpoint-basiert)</title>
                                    <title lang="ru">Контейнер Preline (по контрольным точкам)</title>
                                    <title lang="es">Contenedor Preline (por Breakpoint)</title>
                                    <title lang="fr">Conteneur Preline (par Breakpoint)</title>
                                </meta>
                            </param>
                            <param name="7xl">
                                <meta>
                                    <title lang="en">Extra Large</title>
                                    <title lang="tr">Geniş</title>
                                    <title lang="de">Extra Groß</title>
                                    <title lang="ru">Очень большой</title>
                                    <title lang="es">Extra Grande</title>
                                    <title lang="fr">Très Grand</title>
                                </meta>
                            </param>
                            <param name="5xl">
                                <meta>
                                    <title lang="en">Medium</title>
                                    <title lang="tr">Orta</title>
                                    <title lang="de">Mittel</title>
                                    <title lang="ru">Средний</title>
                                    <title lang="es">Mediano</title>
                                    <title lang="fr">Moyen</title>
                                </meta>
                            </param>
                            <param name="3xl">
                                <meta>
                                    <title lang="en">Narrow / Prose</title>
                                    <title lang="tr">Dar</title>
                                    <title lang="de">Schmal / Text</title>
                                    <title lang="ru">Узкий / Текст</title>
                                    <title lang="es">Estrecho / Texto</title>
                                    <title lang="fr">Étroit / Texte</title>
                                </meta>
                            </param>
                            <param name="full">
                                <meta>
                                    <title lang="en">Full Width</title>
                                    <title lang="tr">Tam Genişlik</title>
                                    <title lang="de">Volle Breite</title>
                                    <title lang="ru">Во всю ширину</title>
                                    <title lang="es">Ancho Completo</title>
                                    <title lang="fr">Pleine Largeur</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="bg_style" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Background Style</title>
                        <title lang="tr">Arka Plan Stili</title>
                        <title lang="de">Hintergrund-Stil</title>
                        <title lang="ru">Стиль фона</title>
                        <title lang="es">Estilo de Fondo</title>
                        <title lang="fr">Style de Fond</title>
                    </meta>
                    <params>
                        <param name="default_value" value="transparent"/>
                        <param name="values" type="collection">
                            <param name="transparent">
                                <meta>
                                    <title lang="en">Transparent</title>
                                    <title lang="tr">Şeffaf</title>
                                    <title lang="de">Transparent</title>
                                    <title lang="ru">Прозрачный</title>
                                    <title lang="es">Transparente</title>
                                    <title lang="fr">Transparent</title>
                                </meta>
                            </param>
                            <param name="default">
                                <meta>
                                    <title lang="en">Surface</title>
                                    <title lang="tr">Yüzey</title>
                                    <title lang="de">Oberfläche</title>
                                    <title lang="ru">Поверхность</title>
                                    <title lang="es">Superficie</title>
                                    <title lang="fr">Surface</title>
                                </meta>
                            </param>
                            <param name="muted">
                                <meta>
                                    <title lang="en">Muted</title>
                                    <title lang="tr">Mat</title>
                                    <title lang="de">Gedämpft</title>
                                    <title lang="ru">Приглушённый</title>
                                    <title lang="es">Atenuado</title>
                                    <title lang="fr">Atténué</title>
                                </meta>
                            </param>
                            <param name="subtle">
                                <meta>
                                    <title lang="en">Subtle Background</title>
                                    <title lang="tr">Hafif Arka Plan</title>
                                    <title lang="de">Dezenter Hintergrund</title>
                                    <title lang="ru">Лёгкий фон</title>
                                    <title lang="es">Fondo Sutil</title>
                                    <title lang="fr">Fond Subtil</title>
                                </meta>
                            </param>
                            <param name="primary">
                                <meta>
                                    <title lang="en">Primary Brand Theme</title>
                                    <title lang="tr">Birincil Vurgu Rengi</title>
                                    <title lang="de">Primäres Markenthema</title>
                                    <title lang="ru">Основная тема бренда</title>
                                    <title lang="es">Tema de Marca Primario</title>
                                    <title lang="fr">Thème de Marque Primaire</title>
                                </meta>
                            </param>
                            <param name="secondary">
                                <meta>
                                    <title lang="en">Secondary Brand Theme</title>
                                    <title lang="tr">İkincil Vurgu Rengi</title>
                                    <title lang="de">Sekundäres Markenthema</title>
                                    <title lang="ru">Вторичная тема бренда</title>
                                    <title lang="es">Tema de Marca Secundario</title>
                                    <title lang="fr">Thème de Marque Secondaire</title>
                                </meta>
                            </param>
                            <param name="dark">
                                <meta>
                                    <title lang="en">Dark Inverted</title>
                                    <title lang="tr">Koyu / Siyah</title>
                                    <title lang="de">Dunkel Invertiert</title>
                                    <title lang="ru">Тёмный инвертированный</title>
                                    <title lang="es">Oscuro Invertido</title>
                                    <title lang="fr">Sombre Inversé</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <xi:include href="../fields/padding.xml" xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:*)"/>
                <xi:include href="../../forms/fields/margin.xml" xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/sulu:*)"/>
            </properties>
        </section>
    </properties>
</template>
