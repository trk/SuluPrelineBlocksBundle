<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>table</key>
    <meta>
        <title lang="en">Data Table</title>
        <title lang="tr">Veri Tablosu</title>
        <title lang="de">Datentabelle</title>
        <title lang="ru">Таблица данных</title>
        <title lang="es">Tabla de datos</title>
        <title lang="fr">Tableau de données</title>
    </meta>
    <properties>
        <xi:include href="../fields/title.xml"/>

        <property name="header_title" type="text_line">
            <meta>
                <title lang="en">Title Column Header</title>
                <title lang="tr">Başlık Sütun Başlığı</title>
            </meta>
        </property>

        <property name="header_meta" type="text_line">
            <meta>
                <title lang="en">Meta/Subtext Column Header</title>
                <title lang="tr">Alt Başlık Sütun Başlığı</title>
            </meta>
        </property>

        <property name="header_content" type="text_line">
            <meta>
                <title lang="en">Description Column Header</title>
                <title lang="tr">Açıklama Sütun Başlığı</title>
            </meta>
        </property>

        <property name="header_badge" type="text_line">
            <meta>
                <title lang="en">Badge/Status Column Header</title>
                <title lang="tr">Rozet/Durum Sütun Başlığı</title>
            </meta>
        </property>

        <property name="header_link" type="text_line">
            <meta>
                <title lang="en">Action/Link Column Header</title>
                <title lang="tr">Eylem/Bağlantı Sütun Başlığı</title>
            </meta>
        </property>

        <block name="items" default-type="table_item" minOccurs="1">
            <meta>
                <title lang="en">Table Rows</title>
                <title lang="tr">Tablo Satırları</title>
                <title lang="de">Tabellenzeilen</title>
                <title lang="ru">Строки таблицы</title>
                <title lang="es">Filas de tabla</title>
                <title lang="fr">Lignes de tableau</title>
            </meta>
            <types>
                <xi:include href="../block-items/table_item.xml"/>
            </types>
        </block>

        <property name="props" type="block_props" colspan="12">
            <params>
                <param name="component_type" value="table"/>
            </params>
        </property>
    </properties>
</template>
