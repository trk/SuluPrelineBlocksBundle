<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>divider</key>
    <meta>
        <title lang="en">Divider</title>
        <title lang="tr">Ayırıcı Çizgi</title>
        <title lang="ru">Разделитель</title>
        <title lang="fr">Séparateur</title>
        <title lang="es">Separador</title>
        <title lang="de">Trennlinie</title>
    </meta>
    <tag name="sulu_block_suite.tabs" exclude="dynamic_content"/>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <xi:include href="../fields/icon.xml"/>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <property name="divider_style" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Divider Style</title>
                        <title lang="tr">Çizgi Stili</title>
                        <title lang="de">Trennlinien-Stil</title>
                        <title lang="ru">Стиль разделителя</title>
                        <title lang="es">Estilo de Divisor</title>
                        <title lang="fr">Style de Séparateur</title>
                    </meta>
                    <params>
                        <param name="default_value" value="line"/>
                        <param name="values" type="collection">
                            <param name="line">
                                <meta>
                                    <title lang="en">Solid Line</title>
                                    <title lang="tr">Düz Çizgi</title>
                                    <title lang="de">Durchgezogene Linie</title>
                                    <title lang="ru">Сплошная линия</title>
                                    <title lang="es">Línea Sólida</title>
                                    <title lang="fr">Ligne Continue</title>
                                </meta>
                            </param>
                            <param name="dashed">
                                <meta>
                                    <title lang="en">Dashed</title>
                                    <title lang="tr">Kesikli Çizgi</title>
                                    <title lang="de">Gestrichelt</title>
                                    <title lang="ru">Пунктирная</title>
                                    <title lang="es">Discontinua</title>
                                    <title lang="fr">Tirets</title>
                                </meta>
                            </param>
                            <param name="dotted">
                                <meta>
                                    <title lang="en">Dotted</title>
                                    <title lang="tr">Noktalı Çizgi</title>
                                    <title lang="de">Gepunktet</title>
                                    <title lang="ru">Точечная</title>
                                    <title lang="es">Punteada</title>
                                    <title lang="fr">Pointillés</title>
                                </meta>
                            </param>
                            <param name="small">
                                <meta>
                                    <title lang="en">Short Accent Bar</title>
                                    <title lang="tr">Kısa Vurgu Çizgisi</title>
                                    <title lang="de">Kurzer Akzentbalken</title>
                                    <title lang="ru">Короткая акцентная полоса</title>
                                    <title lang="es">Barra Corta de Acento</title>
                                    <title lang="fr">Barre d&apos;Accent Courte</title>
                                </meta>
                            </param>
                            <param name="icon">
                                <meta>
                                    <title lang="en">With Center Icon</title>
                                    <title lang="tr">Ortasında İkonlu</title>
                                    <title lang="de">Mit zentriertem Symbol</title>
                                    <title lang="ru">С иконкой по центру</title>
                                    <title lang="es">Con Icono Central</title>
                                    <title lang="fr">Avec Icône Centrale</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="divider_color" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Color</title>
                        <title lang="tr">Renk</title>
                        <title lang="de">Farbe</title>
                        <title lang="ru">Цвет</title>
                        <title lang="es">Color</title>
                        <title lang="fr">Couleur</title>
                    </meta>
                    <params>
                        <param name="default_value" value="default"/>
                        <param name="values" type="collection">
                            <param name="default">
                                <meta>
                                    <title lang="en">Neutral / Gray</title>
                                    <title lang="tr">Standart / Gri</title>
                                    <title lang="de">Neutral / Grau</title>
                                    <title lang="ru">Нейтральный / Серый</title>
                                    <title lang="es">Neutro / Gris</title>
                                    <title lang="fr">Neutre / Gris</title>
                                </meta>
                            </param>
                            <param name="primary">
                                <meta>
                                    <title lang="en">Primary Blue</title>
                                    <title lang="tr">Birincil Mavi</title>
                                    <title lang="de">Primärblau</title>
                                    <title lang="ru">Основной синий</title>
                                    <title lang="es">Azul Primario</title>
                                    <title lang="fr">Bleu Primaire</title>
                                </meta>
                            </param>
                            <param name="muted">
                                <meta>
                                    <title lang="en">Muted / Soft</title>
                                    <title lang="tr">Açık / Yumuşak</title>
                                    <title lang="de">Gedämpft / Sanft</title>
                                    <title lang="ru">Приглушённый / Мягкий</title>
                                    <title lang="es">Atenuado / Suave</title>
                                    <title lang="fr">Atténué / Doux</title>
                                </meta>
                            </param>
                            <param name="dark">
                                <meta>
                                    <title lang="en">Dark</title>
                                    <title lang="tr">Koyu</title>
                                    <title lang="de">Dunkel</title>
                                    <title lang="ru">Тёмный</title>
                                    <title lang="es">Oscuro</title>
                                    <title lang="fr">Sombre</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="divider_thickness" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Thickness</title>
                        <title lang="tr">Kalınlık</title>
                        <title lang="de">Stärke</title>
                        <title lang="ru">Толщина</title>
                        <title lang="es">Grosor</title>
                        <title lang="fr">Épaisseur</title>
                    </meta>
                    <params>
                        <param name="default_value" value="1"/>
                        <param name="values" type="collection">
                            <param name="1">
                                <meta>
                                    <title lang="en">1px</title>
                                    <title lang="tr">1px</title>
                                    <title lang="de">1px</title>
                                    <title lang="ru">1px</title>
                                    <title lang="es">1px</title>
                                    <title lang="fr">1px</title>
                                </meta>
                            </param>
                            <param name="2">
                                <meta>
                                    <title lang="en">2px</title>
                                    <title lang="tr">2px</title>
                                    <title lang="de">2px</title>
                                    <title lang="ru">2px</title>
                                    <title lang="es">2px</title>
                                    <title lang="fr">2px</title>
                                </meta>
                            </param>
                            <param name="4">
                                <meta>
                                    <title lang="en">4px</title>
                                    <title lang="tr">4px</title>
                                    <title lang="de">4px</title>
                                    <title lang="ru">4px</title>
                                    <title lang="es">4px</title>
                                    <title lang="fr">4px</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="divider_width" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Width</title>
                        <title lang="tr">Genişlik</title>
                        <title lang="de">Breite</title>
                        <title lang="ru">Ширина</title>
                        <title lang="es">Ancho</title>
                        <title lang="fr">Largeur</title>
                    </meta>
                    <params>
                        <param name="default_value" value="full"/>
                        <param name="values" type="collection">
                            <param name="full">
                                <meta>
                                    <title lang="en">Full Width</title>
                                    <title lang="tr">Tam Genişlik</title>
                                    <title lang="de">Volle Breite</title>
                                    <title lang="ru">Во всю ширину</title>
                                    <title lang="es">Ancho Completo</title>
                                    <title lang="fr">Pleine Largeur</title>
                                </meta>
                            </param>
                            <param name="3-4">
                                <meta>
                                    <title lang="en">3/4</title>
                                    <title lang="tr">3/4</title>
                                    <title lang="de">3/4</title>
                                    <title lang="ru">3/4</title>
                                    <title lang="es">3/4</title>
                                    <title lang="fr">3/4</title>
                                </meta>
                            </param>
                            <param name="1-2">
                                <meta>
                                    <title lang="en">1/2</title>
                                    <title lang="tr">1/2</title>
                                    <title lang="de">1/2</title>
                                    <title lang="ru">1/2</title>
                                    <title lang="es">1/2</title>
                                    <title lang="fr">1/2</title>
                                </meta>
                            </param>
                            <param name="1-3">
                                <meta>
                                    <title lang="en">1/3</title>
                                    <title lang="tr">1/3</title>
                                    <title lang="de">1/3</title>
                                    <title lang="ru">1/3</title>
                                    <title lang="es">1/3</title>
                                    <title lang="fr">1/3</title>
                                </meta>
                            </param>
                            <param name="small">
                                <meta>
                                    <title lang="en">Compact</title>
                                    <title lang="tr">Küçük</title>
                                    <title lang="de">Kompakt</title>
                                    <title lang="ru">Компактный</title>
                                    <title lang="es">Compacto</title>
                                    <title lang="fr">Compact</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="divider_align" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Alignment</title>
                        <title lang="tr">Hizalama</title>
                        <title lang="de">Ausrichtung</title>
                        <title lang="ru">Выравнивание</title>
                        <title lang="es">Alineación</title>
                        <title lang="fr">Alignement</title>
                    </meta>
                    <params>
                        <param name="default_value" value="center"/>
                        <param name="values" type="collection">
                            <param name="center">
                                <meta>
                                    <title lang="en">Center</title>
                                    <title lang="tr">Ortalı</title>
                                    <title lang="de">Zentriert</title>
                                    <title lang="ru">По центру</title>
                                    <title lang="es">Centro</title>
                                    <title lang="fr">Centre</title>
                                </meta>
                            </param>
                            <param name="left">
                                <meta>
                                    <title lang="en">Left</title>
                                    <title lang="tr">Sola Yaslı</title>
                                    <title lang="de">Links</title>
                                    <title lang="ru">Слева</title>
                                    <title lang="es">Izquierda</title>
                                    <title lang="fr">Gauche</title>
                                </meta>
                            </param>
                            <param name="right">
                                <meta>
                                    <title lang="en">Right</title>
                                    <title lang="tr">Sağa Yaslı</title>
                                    <title lang="de">Rechts</title>
                                    <title lang="ru">Справа</title>
                                    <title lang="es">Derecha</title>
                                    <title lang="fr">Droite</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</template>

