<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>list</key>
    <meta>
        <title lang="en">List</title>
        <title lang="tr">Liste</title>
        <title lang="de">Liste</title>
        <title lang="ru">Список</title>
        <title lang="es">Lista</title>
        <title lang="fr">Liste</title>
    </meta>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <xi:include href="../fields/title.xml"/>

                <block name="items" default-type="list_item" minOccurs="1">
                    <meta>
                        <title lang="en">List Items</title>
                        <title lang="tr">Liste Maddeleri</title>
                        <title lang="de">Listenelemente</title>
                        <title lang="ru">Элементы списка</title>
                        <title lang="es">Elementos de lista</title>
                        <title lang="fr">Éléments de liste</title>
                    </meta>
                    <types>
                        <xi:include href="../block-items/list_item.xml"/>
                    </types>
                </block>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <property name="list_type" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">List Orientation</title>
                        <title lang="tr">Liste Yönü</title>
                        <title lang="de">Listenausrichtung</title>
                        <title lang="ru">Ориентация списка</title>
                        <title lang="es">Orientación de la Lista</title>
                        <title lang="fr">Orientation de la Liste</title>
                    </meta>
                    <params>
                        <param name="default_value" value="vertical"/>
                        <param name="values" type="collection">
                            <param name="vertical">
                                <meta>
                                    <title lang="en">Vertical Stack</title>
                                    <title lang="tr">Dikey Liste</title>
                                    <title lang="de">Vertikaler Stapel</title>
                                    <title lang="ru">Вертикальный список</title>
                                    <title lang="es">Pila Vertical</title>
                                    <title lang="fr">Pile Verticale</title>
                                </meta>
                            </param>
                            <param name="horizontal">
