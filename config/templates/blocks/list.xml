                                    <title lang="es">Horizontal en Línea</title>
                                    <title lang="fr">Horizontal en Ligne</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="columns" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Columns</title>
                        <title lang="tr">Sütun Sayısı</title>
                        <title lang="de">Spalten</title>
                        <title lang="ru">Колонки</title>
                        <title lang="es">Columnas</title>
                        <title lang="fr">Colonnes</title>
                    </meta>
                    <params>
                        <param name="default_value" value="1"/>
                        <param name="values" type="collection">
                            <param name="1">
                                <meta>
                                    <title lang="en">1 Column</title>
                                    <title lang="tr">1 Sütun</title>
                                    <title lang="de">1 Spalte</title>
                                    <title lang="ru">1 колонка</title>
                                    <title lang="es">1 Columna</title>
                                    <title lang="fr">1 Colonne</title>
                                </meta>
                            </param>
                            <param name="2">
                                <meta>
                                    <title lang="en">2 Columns</title>
                                    <title lang="tr">2 Sütun</title>
                                    <title lang="de">2 Spalten</title>
                                    <title lang="ru">2 колонки</title>
                                    <title lang="es">2 Columnas</title>
                                    <title lang="fr">2 Colonnes</title>
                                </meta>
                            </param>
                            <param name="3">
                                <meta>
                                    <title lang="en">3 Columns</title>
                                    <title lang="tr">3 Sütun</title>
                                    <title lang="de">3 Spalten</title>
                                    <title lang="ru">3 колонки</title>
                                    <title lang="es">3 Columnas</title>
                                    <title lang="fr">3 Colonnes</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="spacing" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Item Spacing</title>
                        <title lang="tr">Öğeler Arası Boşluk</title>
                        <title lang="de">Elementabstand</title>
                        <title lang="ru">Отступ между элементами</title>
                        <title lang="es">Espaciado entre Elementos</title>
                        <title lang="fr">Espacement des Éléments</title>
                    </meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm">
                                <meta>
                                    <title lang="en">Compact</title>
                                    <title lang="tr">Dar</title>
                                    <title lang="de">Kompakt</title>
                                    <title lang="ru">Компактный</title>
                                    <title lang="es">Compacto</title>
                                    <title lang="fr">Compact</title>
                                </meta>
                            </param>
                            <param name="md">
                                <meta>
                                    <title lang="en">Normal</title>
                                    <title lang="tr">Standart</title>
                                    <title lang="de">Normal</title>
                                    <title lang="ru">Обычный</title>
                                    <title lang="es">Normal</title>
                                    <title lang="fr">Normal</title>
                                </meta>
                            </param>
                            <param name="lg">
                                <meta>
                                    <title lang="en">Spacious</title>
                                    <title lang="tr">Geniş</title>
                                    <title lang="de">Geräumig</title>
                                    <title lang="ru">Просторный</title>
                                    <title lang="es">Espacioso</title>
                                    <title lang="fr">Spacieux</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="size" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Text Size</title>
                        <title lang="tr">Metin Boyutu</title>
                        <title lang="de">Textgröße</title>
                        <title lang="ru">Размер текста</title>
                        <title lang="es">Tamaño de Texto</title>
                        <title lang="fr">Taille du Texte</title>
                    </meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm">
                                <meta>
                                    <title lang="en">Small</title>
                                    <title lang="tr">Küçük</title>
                                    <title lang="de">Klein</title>
                                    <title lang="ru">Малый</title>
                                    <title lang="es">Pequeño</title>
                                    <title lang="fr">Petit</title>
                                </meta>
                            </param>
                            <param name="md">
                                <meta>
                                    <title lang="en">Medium</title>
                                    <title lang="tr">Standart</title>
                                    <title lang="de">Mittel</title>
                                    <title lang="ru">Средний</title>
                                    <title lang="es">Mediano</title>
                                    <title lang="fr">Moyen</title>
                                </meta>
                            </param>
                            <param name="lg">
                                <meta>
                                    <title lang="en">Large</title>
                                    <title lang="tr">Büyük</title>
                                    <title lang="de">Groß</title>
                                    <title lang="ru">Большой</title>
                                    <title lang="es">Grande</title>
                                    <title lang="fr">Grand</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="marker" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">List Marker</title>
                        <title lang="tr">Madde İşaretçisi</title>
                        <title lang="de">Listenaufzählungszeichen</title>
                        <title lang="ru">Маркер списка</title>
                        <title lang="es">Marcador de Lista</title>
                        <title lang="fr">Marqueur de Liste</title>
                    </meta>
                    <params>
                        <param name="default_value" value="none"/>
                        <param name="values" type="collection">
                            <param name="none">
                                <meta>
                                    <title lang="en">None</title>
                                    <title lang="tr">Yok</title>
                                    <title lang="de">Keine</title>
                                    <title lang="ru">Нет</title>
                                    <title lang="es">Ninguno</title>
                                    <title lang="fr">Aucun</title>
                                </meta>
                            </param>
                            <param name="checkmark">
                                <meta>
                                    <title lang="en">Checkmark Icon</title>
                                    <title lang="tr">Onay İkonu</title>
                                    <title lang="de">Häkchen-Symbol</title>
                                    <title lang="ru">Иконка галочки</title>
                                    <title lang="es">Icono de Verificación</title>
                                    <title lang="fr">Icône Coche</title>
                                </meta>
                            </param>
                            <param name="icon">
