                                    <title lang="es">Icono Personalizado del Elemento</title>
                                    <title lang="fr">Icône Personnalisée de l&apos;Élément</title>
                                </meta>
                            </param>
                            <param name="disc">
                                <meta>
                                    <title lang="en">Solid Bullet</title>
                                    <title lang="tr">Dolu Nokta</title>
                                    <title lang="de">Gefüllter Punkt</title>
                                    <title lang="ru">Сплошная точка</title>
                                    <title lang="es">Viñeta Sólida</title>
                                    <title lang="fr">Puce Pleine</title>
                                </meta>
                            </param>
                            <param name="circle">
                                <meta>
                                    <title lang="en">Outline Bullet</title>
                                    <title lang="tr">Çember Nokta</title>
                                    <title lang="de">Kreis-Aufzählungszeichen</title>
                                    <title lang="ru">Контурный кружок</title>
                                    <title lang="es">Viñeta Circular</title>
                                    <title lang="fr">Puce Cerclée</title>
                                </meta>
                            </param>
                            <param name="decimal">
                                <meta>
                                    <title lang="en">Numbered</title>
                                    <title lang="tr">Numaralı</title>
                                    <title lang="de">Nummeriert</title>
                                    <title lang="ru">Нумерованный</title>
                                    <title lang="es">Numerado</title>
                                    <title lang="fr">Numéroté</title>
                                </meta>
                            </param>
                        </param>
                    </params>
