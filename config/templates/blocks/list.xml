                    </meta>
                    <params>
                        <param name="default_value" value="default"/>
                        <param name="values" type="collection">
                            <param name="default">
                                <meta>
                                    <title lang="en">Clean</title>
                                    <title lang="tr">Sade</title>
                                    <title lang="de">Schlicht</title>
                                    <title lang="ru">Чистый</title>
                                    <title lang="es">Limpio</title>
                                    <title lang="fr">Épuré</title>
                                </meta>
                            </param>
                            <param name="divider">
                                <meta>
                                    <title lang="en">Divided</title>
                                    <title lang="tr">Çizgi Ayırıcılı</title>
                                    <title lang="de">Getrennt</title>
                                    <title lang="ru">С разделителями</title>
                                    <title lang="es">Dividido</title>
                                    <title lang="fr">Avec Séparateurs</title>
                                </meta>
                            </param>
                            <param name="striped">
                                <meta>
                                    <title lang="en">Striped Background</title>
                                    <title lang="tr">Şeritli Arka Plan</title>
                                    <title lang="de">Gestreifter Hintergrund</title>
                                    <title lang="ru">Полосатый фон</title>
                                    <title lang="es">Fondo Rayado</title>
                                    <title lang="fr">Fond Rayé</title>
                                </meta>
                            </param>
                        </param>
                    </params>
