                        <title lang="tr">İşaretçi Rengi</title>
                        <title lang="de">Markierungsfarbe</title>
                        <title lang="ru">Цвет маркера</title>
                        <title lang="es">Color del Marcador</title>
                        <title lang="fr">Couleur du Marqueur</title>
                    </meta>
                    <params>
                        <param name="default_value" value="primary"/>
                        <param name="values" type="collection">
                            <param name="primary">
                                <meta>
                                    <title lang="en">Primary</title>
                                    <title lang="tr">Birincil Renk</title>
                                    <title lang="de">Primär</title>
                                    <title lang="ru">Основной</title>
                                    <title lang="es">Primario</title>
                                    <title lang="fr">Primaire</title>
                                </meta>
                            </param>
                            <param name="secondary">
                                <meta>
                                    <title lang="en">Secondary</title>
                                    <title lang="tr">İkincil Renk</title>
                                    <title lang="de">Sekundär</title>
                                    <title lang="ru">Вторичный</title>
                                    <title lang="es">Secundario</title>
                                    <title lang="fr">Secondaire</title>
                                </meta>
                            </param>
                            <param name="muted">
                                <meta>
                                    <title lang="en">Muted / Neutral</title>
                                    <title lang="tr">Nötr / Gri</title>
                                    <title lang="de">Gedämpft / Neutral</title>
                                    <title lang="ru">Приглушённый / Нейтральный</title>
                                    <title lang="es">Atenuado / Neutro</title>
                                    <title lang="fr">Atténué / Neutre</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

