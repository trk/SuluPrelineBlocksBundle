                    <meta>
                        <title lang="en">Row Style</title>
                        <title lang="tr">Satır Stili</title>
                        <title lang="de">Zeilenstil</title>
                        <title lang="ru">Стиль строки</title>
                        <title lang="es">Estilo de Fila</title>
