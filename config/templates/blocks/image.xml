                                <meta>
                                    <title lang="en">sulu_block_suite.opt_auto</title>
                                </meta>
                            </param>
                            <param name="16/9">
                                <meta>
                                    <title lang="en">sulu_block_suite.opt_16_9</title>
                                </meta>
