<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>image</key>
    <meta>
        <title lang="en">Image</title>
        <title lang="tr">Görsel</title>
        <title lang="ru">Изображение</title>
        <title lang="fr">Image</title>
        <title lang="es">Imagen</title>
        <title lang="de">Bild</title>
    </meta>
    <tag name="sulu_block_suite.tabs" include_fields="container_padding_remove" text_align="standard"/>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <xi:include href="../fields/image.xml"/>
                <xi:include href="../fields/link.xml"/>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <xi:include href="../fields/media_display.xml"
                            xpointer="xmlns(sulu=http://schemas.sulu.io/template/template)xpointer(/sulu:properties/*)"/>

                <property name="rounded" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Border Radius</title>
                        <title lang="tr">Köşe Yuvarlama</title>
                        <title lang="de">Eckenrundung</title>
                        <title lang="ru">Скругление углов</title>
                        <title lang="es">Radio del Borde</title>
                        <title lang="fr">Rayon de Bordure</title>
                    </meta>
                    <params>
                        <param name="default_value" value="lg"/>
                        <param name="values" type="collection">
                            <param name="none">
                                <meta>
                                    <title lang="en">None</title>
                                    <title lang="tr">Yok</title>
                                    <title lang="de">Keine</title>
                                    <title lang="ru">Нет</title>
                                    <title lang="es">Ninguno</title>
                                    <title lang="fr">Aucun</title>
                                </meta>
                            </param>
                            <param name="sm">
                                <meta>
                                    <title lang="en">Small</title>
                                    <title lang="tr">Küçük</title>
                                    <title lang="de">Klein</title>
                                    <title lang="ru">Малый</title>
                                    <title lang="es">Pequeño</title>
                                    <title lang="fr">Petit</title>
                                </meta>
                            </param>
                            <param name="md">
                                <meta>
                                    <title lang="en">Medium</title>
                                    <title lang="tr">Orta</title>
                                    <title lang="de">Mittel</title>
                                    <title lang="ru">Средний</title>
                                    <title lang="es">Mediano</title>
                                    <title lang="fr">Moyen</title>
                                </meta>
                            </param>
                            <param name="lg">
                                <meta>
                                    <title lang="en">Large</title>
                                    <title lang="tr">Büyük</title>
                                    <title lang="de">Groß</title>
                                    <title lang="ru">Большой</title>
                                    <title lang="es">Grande</title>
                                    <title lang="fr">Grand</title>
                                </meta>
                            </param>
                            <param name="xl">
                                <meta>
                                    <title lang="en">Extra Large</title>
                                    <title lang="tr">Çok Büyük</title>
                                    <title lang="de">Extra Groß</title>
                                    <title lang="ru">Очень большой</title>
                                    <title lang="es">Extra Grande</title>
                                    <title lang="fr">Très Grand</title>
                                </meta>
                            </param>
                            <param name="full">
                                <meta>
                                    <title lang="en">Full / Pill</title>
                                    <title lang="tr">Tam / Yuvarlak</title>
                                    <title lang="de">Voll / Rund</title>
                                    <title lang="ru">Полный / Овал</title>
                                    <title lang="es">Completo / Píldora</title>
                                    <title lang="fr">Complet / Pilule</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="hover_effect" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Hover Effect</title>
                        <title lang="tr">Vurgu Efekti</title>
                        <title lang="de">Hover-Effekt</title>
                        <title lang="ru">Эффект при наведении</title>
                        <title lang="es">Efecto al Pasar el Cursor</title>
                        <title lang="fr">Effet au Survol</title>
                    </meta>
                    <params>
                        <param name="default_value" value="none"/>
                        <param name="values" type="collection">
                            <param name="none">
                                <meta>
                                    <title lang="en">None</title>
                                    <title lang="tr">Yok</title>
                                    <title lang="de">Keine</title>
                                    <title lang="ru">Нет</title>
                                    <title lang="es">Ninguno</title>
                                    <title lang="fr">Aucun</title>
                                </meta>
                            </param>
                            <param name="zoom">
                                <meta>
                                    <title lang="en">Zoom</title>
                                    <title lang="tr">Büyütme</title>
                                    <title lang="de">Vergrößern</title>
                                    <title lang="ru">Увеличение</title>
                                    <title lang="es">Zoom</title>
                                    <title lang="fr">Zoom</title>
                                </meta>
                            </param>
                            <param name="shadow">
                                <meta>
                                    <title lang="en">Shadow</title>
                                    <title lang="tr">Gölgeli</title>
                                    <title lang="de">Schatten</title>
                                    <title lang="ru">С тенью</title>
                                    <title lang="es">Sombra</title>
                                    <title lang="fr">Ombre</title>
                                </meta>
                            </param>
                            <param name="brightness">
                                <meta>
                                    <title lang="en">Brightness</title>
                                    <title lang="tr">Parlaklık</title>
                                    <title lang="de">Helligkeit</title>
                                    <title lang="ru">Яркость</title>
                                    <title lang="es">Brillo</title>
                                    <title lang="fr">Luminosité</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <xi:include href="../fields/image_loading.xml"/>
            </properties>
        </section>
    </properties>
</template>
