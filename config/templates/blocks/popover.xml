<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>popover</key>
    <meta>
        <title lang="en">Media Hotspots</title>
        <title lang="tr">İnteraktif Görsel Noktaları</title>
        <title lang="de">Interaktive Bild-Hotspots</title>
        <title lang="ru">Интерактивные точки на фото</title>
        <title lang="es">Marcadores en imagen</title>
        <title lang="fr">Points interactifs d'image</title>
    </meta>
    <tag name="sulu_block_suite.tabs" exclude="dynamic_content" include_fields="container_padding_remove"/>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <xi:include href="../fields/title.xml"/>

                <property name="image" type="single_media_selection" mandatory="true">
                    <meta>
                        <title lang="en">Background Image</title>
                        <title lang="tr">Arka Plan Görseli</title>
                        <title lang="de">Hintergrundbild</title>
                        <title lang="ru">Фоновое изображение</title>
                        <title lang="es">Imagen de fondo</title>
                        <title lang="fr">Image d'arrière-plan</title>
                    </meta>
                    <params>
                        <param name="types" value="image"/>
                    </params>
                </property>

                <block name="items" default-type="popover_item" minOccurs="1">
                    <meta>
                        <title lang="en">Hotspot Markers</title>
                        <title lang="tr">İnteraktif Noktalar</title>
                        <title lang="de">Hotspot-Markierungen</title>
                        <title lang="ru">Точки на изображении</title>
                        <title lang="es">Marcadores</title>
                        <title lang="fr">Marqueurs</title>
                    </meta>
                    <types>
                        <xi:include href="../block-items/popover_item.xml"/>
                    </types>
                </block>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <property name="trigger" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Trigger Mode</title>
                        <title lang="tr">Açılma Şekli</title>
                        <title lang="de">Auslösemodus</title>
                        <title lang="ru">Режим активации</title>
                        <title lang="es">Modo de Activación</title>
                        <title lang="fr">Mode de Déclenchement</title>
                    </meta>
                    <params>
                        <param name="default_value" value="click"/>
                        <param name="values" type="collection">
                            <param name="click">
                                <meta>
                                    <title lang="en">On Click</title>
                                    <title lang="tr">Tıklama ile</title>
                                    <title lang="de">Bei Klick</title>
                                    <title lang="ru">По клику</title>
                                    <title lang="es">Al Hacer Clic</title>
                                    <title lang="fr">Au Clic</title>
                                </meta>
                            </param>
                            <param name="hover">
                                <meta>
                                    <title lang="en">On Hover</title>
                                    <title lang="tr">Üzerine Gelince</title>
                                    <title lang="de">Bei Hover</title>
                                    <title lang="ru">При наведении</title>
                                    <title lang="es">Al Pasar el Cursor</title>
                                    <title lang="fr">Au Survol</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="marker_type" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Default Marker Style</title>
                        <title lang="tr">Varsayılan İşaretçi Stili</title>
                        <title lang="de">Standard-Markierungsstil</title>
                        <title lang="ru">Стиль маркера по умолчанию</title>
                        <title lang="es">Estilo de Marcador Predeterminado</title>
                        <title lang="fr">Style de Marqueur par Défaut</title>
                    </meta>
                    <params>
                        <param name="default_value" value="pulse"/>
                        <param name="values" type="collection">
                            <param name="pulse">
                                <meta>
                                    <title lang="en">Radar Pulse</title>
                                    <title lang="tr">Radar</title>
                                    <title lang="de">Radar-Impuls</title>
                                    <title lang="ru">Пульсирующий радар</title>
                                    <title lang="es">Pulso de Radar</title>
                                    <title lang="fr">Impulsion Radar</title>
                                </meta>
                            </param>
                            <param name="plus">
                                <meta>
                                    <title lang="en">Plus</title>
                                    <title lang="tr">Artı</title>
                                    <title lang="de">Plus</title>
                                    <title lang="ru">Плюс</title>
                                    <title lang="es">Más</title>
                                    <title lang="fr">Plus</title>
                                </meta>
                            </param>
                            <param name="number">
                                <meta>
                                    <title lang="en">Numbered</title>
                                    <title lang="tr">Numaralı</title>
                                    <title lang="de">Nummeriert</title>
                                    <title lang="ru">Нумерованный</title>
                                    <title lang="es">Numerado</title>
                                    <title lang="fr">Numéroté</title>
                                </meta>
                            </param>
                            <param name="dot">
                                <meta>
                                    <title lang="en">Solid Dot</title>
                                    <title lang="tr">Dolu Nokta</title>
                                    <title lang="de">Gefüllter Punkt</title>
                                    <title lang="ru">Сплошная точка</title>
                                    <title lang="es">Punto Sólido</title>
                                    <title lang="fr">Point Plein</title>
                                </meta>
                            </param>
                            <param name="pin">
                                <meta>
                                    <title lang="en">Map Pin</title>
                                    <title lang="tr">Harita İğnesi</title>
                                    <title lang="de">Karten-Pin</title>
                                    <title lang="ru">Булавка карты</title>
                                    <title lang="es">Pin de Mapa</title>
                                    <title lang="fr">Épingle de Carte</title>
                                </meta>
                            </param>
                            <param name="icon">
                                <meta>
                                    <title lang="en">Custom Icon</title>
                                    <title lang="tr">Özel İkon</title>
                                    <title lang="de">Benutzerdefiniertes Symbol</title>
                                    <title lang="ru">Своя иконка</title>
                                    <title lang="es">Icono Personalizado</title>
                                    <title lang="fr">Icône Personnalisée</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="icon" type="single_icon_selection" colspan="6" visibleCondition="marker_type == 'icon'">
                    <meta>
                        <title lang="en">Default Marker Icon</title>
                        <title lang="tr">Varsayılan İşaretçi İkonu</title>
                        <title lang="de">Standard-Markierungssymbol</title>
                        <title lang="ru">Иконка маркера по умолчанию</title>
                        <title lang="es">Icono de Marcador Predeterminado</title>
                        <title lang="fr">Icône de Marqueur par Défaut</title>
                    </meta>
                    <params>
                        <param name="icon_set" value="tabler"/>
                    </params>
                </property>

                <property name="marker_color" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Default Marker Color</title>
                        <title lang="tr">Varsayılan İşaretçi Rengi</title>
                        <title lang="de">Standard-Markierungsfarbe</title>
                        <title lang="ru">Цвет маркера по умолчанию</title>
                        <title lang="es">Color de Marcador Predeterminado</title>
                        <title lang="fr">Couleur de Marqueur par Défaut</title>
                    </meta>
                    <params>
                        <param name="default_value" value="primary"/>
                        <param name="values" type="collection">
                            <param name="primary">
                                <meta>
                                    <title lang="en">Primary</title>
                                    <title lang="tr">Birincil</title>
                                    <title lang="de">Primär</title>
                                    <title lang="ru">Основной</title>
                                    <title lang="es">Primario</title>
                                    <title lang="fr">Primaire</title>
                                </meta>
                            </param>
                            <param name="dark">
                                <meta>
                                    <title lang="en">Dark Neutral</title>
                                    <title lang="tr">Koyu Gri</title>
                                    <title lang="de">Dunkel Neutral</title>
                                    <title lang="ru">Тёмно-нейтральный</title>
                                    <title lang="es">Neutro Oscuro</title>
                                    <title lang="fr">Neutre Sombre</title>
                                </meta>
                            </param>
                            <param name="light">
                                <meta>
                                    <title lang="en">Light</title>
                                    <title lang="tr">Açık / Beyaz</title>
                                    <title lang="de">Hell</title>
                                    <title lang="ru">Светлый</title>
                                    <title lang="es">Claro</title>
                                    <title lang="fr">Clair</title>
                                </meta>
                            </param>
                            <param name="accent">
                                <meta>
                                    <title lang="en">Accent</title>
                                    <title lang="tr">Vurgu</title>
                                    <title lang="de">Akzent</title>
                                    <title lang="ru">Акцент</title>
                                    <title lang="es">Acento</title>
                                    <title lang="fr">Accent</title>
                                </meta>
                            </param>
                            <param name="success">
                                <meta>
                                    <title lang="en">Success</title>
                                    <title lang="tr">Yeşil</title>
                                    <title lang="de">Erfolg</title>
                                    <title lang="ru">Успех</title>
                                    <title lang="es">Éxito</title>
                                    <title lang="fr">Succès</title>
                                </meta>
                            </param>
                            <param name="danger">
                                <meta>
                                    <title lang="en">Danger</title>
                                    <title lang="tr">Kırmızı</title>
                                    <title lang="de">Gefahr</title>
                                    <title lang="ru">Опасность</title>
                                    <title lang="es">Peligro</title>
                                    <title lang="fr">Danger</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <xi:include href="../fields/image_loading.xml"/>
            </properties>
        </section>
    </properties>
</template>
