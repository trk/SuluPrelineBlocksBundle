<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>popover</key>
    <meta>
        <title lang="en">Media Hotspots (Popover)</title>
        <title lang="tr">İnteraktif Görsel Noktaları (Popover)</title>
        <title lang="de">Interaktive Bild-Hotspots</title>
        <title lang="ru">Интерактивные точки на фото</title>
        <title lang="es">Marcadores en imagen</title>
        <title lang="fr">Points interactifs d'image</title>
    </meta>
    <properties>
        <xi:include href="../fields/title.xml"/>

        <property name="image" type="single_media_selection" mandatory="true">
            <meta>
                <title lang="en">Background Image</title>
                <title lang="tr">Arka Plan Görseli</title>
                <title lang="de">Hintergrundbild</title>
                <title lang="ru">Фоновое изображение</title>
                <title lang="es">Imagen de fondo</title>
                <title lang="fr">Image d'arrière-plan</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="trigger" type="single_select" colspan="12">
            <meta>
                <title lang="en">Trigger Mode</title>
                <title lang="tr">Açılma Şekli</title>
                <title lang="de">Auslösemodus</title>
                <title lang="ru">Режим активации</title>
                <title lang="es">Modo de activación</title>
                <title lang="fr">Mode de déclenchement</title>
                <info_text lang="en">How the card popovers are revealed</info_text>
                <info_text lang="tr">Nokta kartlarının açılma şekli</info_text>
                <info_text lang="de">Wie die Popover-Karten geöffnet werden</info_text>
                <info_text lang="ru">Как открываются карточки меток</info_text>
                <info_text lang="es">Cómo se muestran las tarjetas emergentes</info_text>
                <info_text lang="fr">Comment les cartes popover sont révélées</info_text>
            </meta>
            <params>
                <param name="default_value" value="click"/>
                <param name="values" type="collection">
                    <param name="click">
                        <meta>
                            <title lang="en">On Click</title>
                            <title lang="tr">Tıklama ile (Click)</title>
                            <title lang="de">Beim Klicken</title>
                            <title lang="ru">По клику</title>
                            <title lang="es">Al hacer clic</title>
                            <title lang="fr">Au clic</title>
                        </meta>
                    </param>
                    <param name="hover">
                        <meta>
                            <title lang="en">On Hover</title>
                            <title lang="tr">Hover (Üzerine Gelme)</title>
                            <title lang="de">Beim Überfahren (Hover)</title>
                            <title lang="ru">При наведении (Hover)</title>
                            <title lang="es">Al pasar el cursor (Hover)</title>
                            <title lang="fr">Au survol (Hover)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="marker_type" type="single_select" colspan="6">
            <meta>
                <title lang="en">Default Marker Style</title>
                <title lang="tr">Varsayılan İşaretçi Stili</title>
                <title lang="de">Standard-Markierungsstil</title>
                <title lang="ru">Стиль маркера по умолчанию</title>
                <title lang="es">Estilo de marcador predeterminado</title>
                <title lang="fr">Style de marqueur par défaut</title>
            </meta>
            <params>
                <param name="default_value" value="pulse"/>
                <param name="values" type="collection">
                    <param name="pulse">
                        <meta>
                            <title lang="en">Radar Pulse</title>
                            <title lang="tr">Radar (Pulse)</title>
                            <title lang="de">Radar-Impuls</title>
                            <title lang="ru">Пульсирующий радар</title>
                            <title lang="es">Pulso de radar</title>
                            <title lang="fr">Pulsation radar</title>
                        </meta>
                    </param>
                    <param name="plus">
                        <meta>
                            <title lang="en">Plus (+)</title>
                            <title lang="tr">Artı (+)</title>
                            <title lang="de">Plus (+)</title>
                            <title lang="ru">Плюс (+)</title>
                            <title lang="es">Más (+)</title>
                            <title lang="fr">Plus (+)</title>
                        </meta>
                    </param>
                    <param name="number">
                        <meta>
                            <title lang="en">Number (1, 2, 3...)</title>
                            <title lang="tr">Numara (1, 2, 3...)</title>
                            <title lang="de">Nummer (1, 2, 3...)</title>
                            <title lang="ru">Номер (1, 2, 3...)</title>
                            <title lang="es">Número (1, 2, 3...)</title>
                            <title lang="fr">Numéro (1, 2, 3...)</title>
                        </meta>
                    </param>
                    <param name="dot">
                        <meta>
                            <title lang="en">Solid Dot</title>
                            <title lang="tr">Nokta (Dot)</title>
                            <title lang="de">Punkt (Dot)</title>
                            <title lang="ru">Точка (Dot)</title>
                            <title lang="es">Punto (Dot)</title>
                            <title lang="fr">Point (Dot)</title>
                        </meta>
                    </param>
                    <param name="pin">
                        <meta>
                            <title lang="en">Map Pin</title>
                            <title lang="tr">Harita İğnesi</title>
                            <title lang="de">Kartenstecknadel</title>
                            <title lang="ru">Булавка на карте</title>
                            <title lang="es">Pin de mapa</title>
                            <title lang="fr">Épingle de carte</title>
                        </meta>
                    </param>
                    <param name="icon">
                        <meta>
                            <title lang="en">Custom Icon</title>
                            <title lang="tr">Özel İkon</title>
                            <title lang="de">Eigenes Symbol</title>
                            <title lang="ru">Пользовательская иконка</title>
                            <title lang="es">Icono personalizado</title>
                            <title lang="fr">Icône personnalisée</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="marker_color" type="single_select" colspan="6">
            <meta>
                <title lang="en">Default Marker Color</title>
                <title lang="tr">Varsayılan İşaretçi Rengi</title>
                <title lang="de">Standard-Markierungsfarbe</title>
                <title lang="ru">Цвет маркера по умолчанию</title>
                <title lang="es">Color de marcador predeterminado</title>
                <title lang="fr">Couleur de marqueur par défaut</title>
            </meta>
            <params>
                <param name="default_value" value="primary"/>
                <param name="values" type="collection">
                    <param name="primary">
                        <meta>
                            <title lang="en">Primary (Blue)</title>
                            <title lang="tr">Birincil (Mavi)</title>
                            <title lang="de">Primär (Blau)</title>
                            <title lang="ru">Основной (Синий)</title>
                            <title lang="es">Primario (Azul)</title>
                            <title lang="fr">Primaire (Bleu)</title>
                        </meta>
                    </param>
                    <param name="dark">
                        <meta>
                            <title lang="en">Dark Neutral</title>
                            <title lang="tr">Koyu Gri</title>
                            <title lang="de">Dunkelgrau</title>
                            <title lang="ru">Тёмно-серый</title>
                            <title lang="es">Gris oscuro</title>
                            <title lang="fr">Gris foncé</title>
                        </meta>
                    </param>
                    <param name="light">
                        <meta>
                            <title lang="en">Light (White)</title>
                            <title lang="tr">Açık / Beyaz</title>
                            <title lang="de">Hell / Weiß</title>
                            <title lang="ru">Светлый / Белый</title>
                            <title lang="es">Claro / Blanco</title>
                            <title lang="fr">Clair / Blanc</title>
                        </meta>
                    </param>
                    <param name="accent">
                        <meta>
                            <title lang="en">Accent (Amber)</title>
                            <title lang="tr">Sarı / Vurgu</title>
                            <title lang="de">Akzent (Bernstein)</title>
                            <title lang="ru">Акцент (Янтарный)</title>
                            <title lang="es">Acento (Ámbar)</title>
                            <title lang="fr">Accent (Ambre)</title>
                        </meta>
                    </param>
                    <param name="success">
                        <meta>
                            <title lang="en">Success (Green)</title>
                            <title lang="tr">Yeşil</title>
                            <title lang="de">Erfolg (Grün)</title>
                            <title lang="ru">Успех (Зелёный)</title>
                            <title lang="es">Éxito (Verde)</title>
                            <title lang="fr">Succès (Vert)</title>
                        </meta>
                    </param>
                    <param name="danger">
                        <meta>
                            <title lang="en">Danger (Red)</title>
                            <title lang="tr">Kırmızı</title>
                            <title lang="de">Gefahr (Rot)</title>
                            <title lang="ru">Опасность (Красный)</title>
                            <title lang="es">Peligro (Rojo)</title>
                            <title lang="fr">Danger (Rouge)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="icon" type="single_icon_selection" colspan="12" visibleCondition="marker_type == 'icon'">
            <meta>
                <title lang="en">Default Marker Icon</title>
                <title lang="tr">Varsayılan İşaretçi İkonu</title>
                <title lang="de">Standard-Markierungssymbol</title>
                <title lang="ru">Иконка маркера по умолчанию</title>
                <title lang="es">Icono de marcador predeterminado</title>
                <title lang="fr">Icône de marqueur par défaut</title>
            </meta>
            <params>
                <param name="icon_set" value="tabler"/>
            </params>
        </property>

        <block name="items" default-type="popover_item" minOccurs="1">
            <meta>
                <title lang="en">Hotspot Markers</title>
                <title lang="tr">İnteraktif Noktalar</title>
                <title lang="de">Hotspot-Markierungen</title>
                <title lang="ru">Точки на изображении</title>
                <title lang="es">Marcadores</title>
                <title lang="fr">Marqueurs</title>
            </meta>
            <types>
                <xi:include href="../block-items/popover_item.xml"/>
            </types>
        </block>

        <property name="props" type="block_props" colspan="12">
            <params>
                <param name="component_type" value="popover"/>
            </params>
        </property>
    </properties>
</template>
