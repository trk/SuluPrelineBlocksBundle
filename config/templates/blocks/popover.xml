<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>popover</key>
    <meta>
        <title lang="en">Media Hotspots (Popover)</title>
        <title lang="tr">İnteraktif Görsel Noktaları (Popover)</title>
        <title lang="de">Interaktive Bild-Hotspots</title>
        <title lang="ru">Интерактивные точки на фото</title>
        <title lang="es">Marcadores en imagen</title>
        <title lang="fr">Points interactifs d'image</title>
    </meta>
    <properties>
        <xi:include href="../fields/title.xml"/>

        <property name="image" type="single_media_selection" mandatory="true">
            <meta>
                <title lang="en">Background Image</title>
                <title lang="tr">Arka Plan Görseli</title>
            </meta>
            <params>
                <param name="types" value="image"/>
            </params>
        </property>

        <property name="trigger" type="single_select" colspan="4">
            <meta>
                <title lang="en">Trigger Mode</title>
                <title lang="tr">Açılma Şekli</title>
                <info_text lang="en">How the card popovers are revealed</info_text>
                <info_text lang="tr">Nokta kartlarının açılma şekli</info_text>
            </meta>
            <params>
                <param name="default_value" value="click"/>
                <param name="values" type="collection">
                    <param name="click">
                        <meta>
                            <title lang="en">On Click</title>
                            <title lang="tr">Tıklama ile (Click)</title>
                        </meta>
                    </param>
                    <param name="hover">
                        <meta>
                            <title lang="en">On Hover</title>
                            <title lang="tr">Hover (Üzerine Gelme)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="marker_type" type="single_select" colspan="4">
            <meta>
                <title lang="en">Default Marker Style</title>
                <title lang="tr">Varsayılan İşaretçi Stili</title>
            </meta>
            <params>
                <param name="default_value" value="pulse"/>
                <param name="values" type="collection">
                    <param name="pulse">
                        <meta>
                            <title lang="en">Radar Pulse</title>
                            <title lang="tr">Radar (Pulse)</title>
                        </meta>
                    </param>
                    <param name="plus">
                        <meta>
                            <title lang="en">Plus (+)</title>
                            <title lang="tr">Artı (+)</title>
                        </meta>
                    </param>
                    <param name="number">
                        <meta>
                            <title lang="en">Number (1, 2, 3...)</title>
                            <title lang="tr">Numara (1, 2, 3...)</title>
                        </meta>
                    </param>
                    <param name="dot">
                        <meta>
                            <title lang="en">Solid Dot</title>
                            <title lang="tr">Nokta (Dot)</title>
                        </meta>
                    </param>
                    <param name="pin">
                        <meta>
                            <title lang="en">Map Pin</title>
                            <title lang="tr">Harita İğnesi</title>
                        </meta>
                    </param>
                    <param name="icon">
                        <meta>
                            <title lang="en">Custom Icon</title>
                            <title lang="tr">Özel İkon</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="marker_color" type="single_select" colspan="4">
            <meta>
                <title lang="en">Default Marker Color</title>
                <title lang="tr">Varsayılan İşaretçi Rengi</title>
            </meta>
            <params>
                <param name="default_value" value="primary"/>
                <param name="values" type="collection">
                    <param name="primary">
                        <meta>
                            <title lang="en">Primary (Blue)</title>
                            <title lang="tr">Birincil (Mavi)</title>
                        </meta>
                    </param>
                    <param name="dark">
                        <meta>
                            <title lang="en">Dark Neutral</title>
                            <title lang="tr">Koyu Gri</title>
                        </meta>
                    </param>
                    <param name="light">
                        <meta>
                            <title lang="en">Light (White)</title>
                            <title lang="tr">Açık / Beyaz</title>
                        </meta>
                    </param>
                    <param name="accent">
                        <meta>
                            <title lang="en">Accent (Amber)</title>
                            <title lang="tr">Sarı / Vurgu</title>
                        </meta>
                    </param>
                    <param name="success">
                        <meta>
                            <title lang="en">Success (Green)</title>
                            <title lang="tr">Yeşil</title>
                        </meta>
                    </param>
                    <param name="danger">
                        <meta>
                            <title lang="en">Danger (Red)</title>
                            <title lang="tr">Kırmızı</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <block name="items" default-type="popover_item" minOccurs="1">
            <meta>
                <title lang="en">Hotspot Markers</title>
                <title lang="tr">İnteraktif Noktalar</title>
                <title lang="de">Hotspot-Markierungen</title>
                <title lang="ru">Точки на изображении</title>
                <title lang="es">Marcadores</title>
                <title lang="fr">Marqueurs</title>
            </meta>
            <types>
                <xi:include href="../block-items/popover_item.xml"/>
            </types>
        </block>

        <property name="props" type="block_props" colspan="12">
            <params>
                <param name="component_type" value="popover"/>
            </params>
        </property>
    </properties>
</template>
