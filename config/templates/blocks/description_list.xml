<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xmlns:xi="http://www.w3.org/2001/XInclude"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>description_list</key>
    <meta>
        <title lang="en">Description List</title>
        <title lang="tr">Tanım Listesi</title>
        <title lang="de">Beschreibungsliste</title>
        <title lang="ru">Список описаний</title>
        <title lang="es">Lista de Descripción</title>
        <title lang="fr">Liste de Description</title>
    </meta>
    <properties>
        <section name="content">
            <meta>
                <title lang="en">Content</title>
                <title lang="tr">İçerik</title>
                <title lang="de">Inhalt</title>
                <title lang="ru">Контент</title>
                <title lang="es">Contenido</title>
                <title lang="fr">Contenu</title>
            </meta>
            <properties>
                <xi:include href="../fields/title.xml"/>

                <block name="items" default-type="description_list_item" minOccurs="1">
                    <meta>
                        <title lang="en">List Items</title>
                        <title lang="tr">Liste Maddeleri</title>
                        <title lang="de">Listenelemente</title>
                        <title lang="ru">Элементы списка</title>
                        <title lang="es">Elementos de Lista</title>
                        <title lang="fr">Éléments de Liste</title>
                    </meta>
                    <types>
                        <xi:include href="../block-items/description_list_item.xml"/>
                    </types>
                </block>
            </properties>
        </section>

        <section name="settings">
            <meta>
                <title lang="en">Settings</title>
                <title lang="tr">Ayarlar</title>
                <title lang="de">Einstellungen</title>
                <title lang="ru">Настройки</title>
                <title lang="es">Ajustes</title>
                <title lang="fr">Paramètres</title>
            </meta>
            <properties>
                <property name="layout" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Layout Mode</title>
                        <title lang="tr">Yerleşim Modu</title>
                        <title lang="de">Layout-Modus</title>
                        <title lang="ru">Режим компоновки</title>
                        <title lang="es">Modo de Diseño</title>
                        <title lang="fr">Mode de Disposition</title>
                    </meta>
                    <params>
                        <param name="default_value" value="horizontal"/>
                        <param name="values" type="collection">
                            <param name="horizontal">
                                <meta>
                                    <title lang="en">Horizontal</title>
                                    <title lang="tr">Yatay</title>
                                    <title lang="de">Horizontal</title>
                                    <title lang="ru">Горизонтально</title>
                                    <title lang="es">Horizontal</title>
                                    <title lang="fr">Horizontal</title>
                                </meta>
                            </param>
                            <param name="stacked">
                                <meta>
                                    <title lang="en">Stacked</title>
                                    <title lang="tr">Dikey</title>
                                    <title lang="de">Gestapelt</title>
                                    <title lang="ru">Вертикально</title>
                                    <title lang="es">Apilado</title>
                                    <title lang="fr">Empilé</title>
                                </meta>
                            </param>
                            <param name="striped">
                                <meta>
                                    <title lang="en">Striped Rows</title>
                                    <title lang="tr">Zebra Çizgili Satırlar</title>
                                    <title lang="de">Gestreifte Zeilen</title>
                                    <title lang="ru">Чередующиеся строки</title>
                                    <title lang="es">Filas Rayadas</title>
                                    <title lang="fr">Lignes Rayées</title>
                                </meta>
                            </param>
                            <param name="bordered">
                                <meta>
                                    <title lang="en">Bordered Cards</title>
                                    <title lang="tr">Çerçeveli Kartlar</title>
                                    <title lang="de">Umrandete Karten</title>
                                    <title lang="ru">Карточки с рамкой</title>
                                    <title lang="es">Tarjetas con Borde</title>
                                    <title lang="fr">Cartes Bordées</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="term_width" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Term Width</title>
                        <title lang="tr">Başlık Genişliği</title>
                        <title lang="de">Begriffsbreite</title>
                        <title lang="ru">Ширина термина</title>
                        <title lang="es">Ancho del Término</title>
                        <title lang="fr">Largeur du Terme</title>
                    </meta>
                    <params>
                        <param name="default_value" value="1-3"/>
                        <param name="values" type="collection">
                            <param name="1-4">
                                <meta>
                                    <title lang="en">25%</title>
                                    <title lang="tr">%25</title>
                                    <title lang="de">25%</title>
                                    <title lang="ru">25%</title>
                                    <title lang="es">25%</title>
                                    <title lang="fr">25%</title>
                                </meta>
                            </param>
                            <param name="1-3">
                                <meta>
                                    <title lang="en">33%</title>
                                    <title lang="tr">%33</title>
                                    <title lang="de">33%</title>
                                    <title lang="ru">33%</title>
                                    <title lang="es">33%</title>
                                    <title lang="fr">33%</title>
                                </meta>
                            </param>
                            <param name="1-2">
                                <meta>
                                    <title lang="en">50%</title>
                                    <title lang="tr">%50</title>
                                    <title lang="de">50%</title>
                                    <title lang="ru">50%</title>
                                    <title lang="es">50%</title>
                                    <title lang="fr">50%</title>
                                </meta>
                            </param>
                            <param name="auto">
                                <meta>
                                    <title lang="en">Auto</title>
                                    <title lang="tr">Otomatik</title>
                                    <title lang="de">Auto</title>
                                    <title lang="ru">Авто</title>
                                    <title lang="es">Auto</title>
                                    <title lang="fr">Auto</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="divider" type="checkbox" colspan="6">
                    <meta>
                        <title lang="en">Show Dividers Between Items</title>
                        <title lang="tr">Maddeler Arasında Ayırıcı Çizgi</title>
                        <title lang="de">Trennlinien zwischen Elementen anzeigen</title>
                        <title lang="ru">Показать разделители между элементами</title>
                        <title lang="es">Mostrar Divisores Entre Elementos</title>
                        <title lang="fr">Afficher les Séparateurs Entre Éléments</title>
                    </meta>
                    <params>
                        <param name="default_value" value="true"/>
                    </params>
                </property>

                <property name="size" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Item Spacing &amp; Size</title>
                        <title lang="tr">Madde Boyutu ve Boşluk</title>
                        <title lang="de">Elementabstand &amp; Größe</title>
                        <title lang="ru">Отступы и размер элементов</title>
                        <title lang="es">Espaciado y Tamaño de Elementos</title>
                        <title lang="fr">Espacement et Taille des Éléments</title>
                    </meta>
                    <params>
                        <param name="default_value" value="md"/>
                        <param name="values" type="collection">
                            <param name="sm">
                                <meta>
                                    <title lang="en">Small</title>
                                    <title lang="tr">Küçük</title>
                                    <title lang="de">Klein</title>
                                    <title lang="ru">Малый</title>
                                    <title lang="es">Pequeño</title>
                                    <title lang="fr">Petit</title>
                                </meta>
                            </param>
                            <param name="md">
                                <meta>
                                    <title lang="en">Medium</title>
                                    <title lang="tr">Orta</title>
                                    <title lang="de">Mittel</title>
                                    <title lang="ru">Средний</title>
                                    <title lang="es">Mediano</title>
                                    <title lang="fr">Moyen</title>
                                </meta>
                            </param>
                            <param name="lg">
                                <meta>
                                    <title lang="en">Large</title>
                                    <title lang="tr">Büyük</title>
                                    <title lang="de">Groß</title>
                                    <title lang="ru">Большой</title>
                                    <title lang="es">Grande</title>
                                    <title lang="fr">Grand</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>

                <property name="term_style" type="single_select" colspan="6">
                    <meta>
                        <title lang="en">Term Font Style</title>
                        <title lang="tr">Terim Başlığı Stili</title>
                        <title lang="de">Schriftstil des Begriffs</title>
                        <title lang="ru">Стиль шрифта термина</title>
                        <title lang="es">Estilo de Fuente del Término</title>
                        <title lang="fr">Style de Police du Terme</title>
                    </meta>
                    <params>
                        <param name="default_value" value="bold"/>
                        <param name="values" type="collection">
                            <param name="bold">
                                <meta>
                                    <title lang="en">Bold</title>
                                    <title lang="tr">Kalın</title>
                                    <title lang="de">Fett</title>
                                    <title lang="ru">Жирный</title>
                                    <title lang="es">Negrita</title>
                                    <title lang="fr">Gras</title>
                                </meta>
                            </param>
                            <param name="medium">
                                <meta>
                                    <title lang="en">Medium</title>
                                    <title lang="tr">Orta</title>
                                    <title lang="de">Mittel</title>
                                    <title lang="ru">Средний</title>
                                    <title lang="es">Medio</title>
                                    <title lang="fr">Moyen</title>
                                </meta>
                            </param>
                            <param name="muted">
                                <meta>
                                    <title lang="en">Muted</title>
                                    <title lang="tr">Gri / Soluk</title>
                                    <title lang="de">Gedämpft</title>
                                    <title lang="ru">Приглушённый</title>
                                    <title lang="es">Atenuado</title>
                                    <title lang="fr">Atténué</title>
                                </meta>
                            </param>
                            <param name="primary">
                                <meta>
                                    <title lang="en">Primary</title>
                                    <title lang="tr">Birincil</title>
                                    <title lang="de">Primär</title>
                                    <title lang="ru">Основной</title>
                                    <title lang="es">Primario</title>
                                    <title lang="fr">Primaire</title>
                                </meta>
                            </param>
                        </param>
                    </params>
                </property>
            </properties>
        </section>
    </properties>
</template>
