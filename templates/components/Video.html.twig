{% set vid_url = this.getVideoUrl() %}
{% set hover_vid_url = this.getHoverVideoUrl() %}
{% set poster_url = this.getPosterUrl() %}
{% set poster_srcset = this.getPosterSrcSet() %}
{% set poster_focus_style = this.getPosterFocusPointStyle() %}
{% set autoplay = this.isAutoplay() %}
{% set autoplay_mode = this.getAutoplayMode() %}
{% set controls = this.isControls() %}
{% set loop = this.isLoop() %}
{% set muted = this.isMuted() %}
{% set preload = this.getPreload() %}
{% set url = this.getUrl() %}
{% set icon_class = this.iconClass %}

{% if this.isBare() %}
    {% if vid_url %}
        <video
            src="{{ vid_url }}"
            {% if poster_url %}poster="{{ poster_url }}"{% endif %}
            {% if controls %}controls{% endif %}
            {% if autoplay %}autoplay{% endif %}
            {% if muted %}muted{% endif %}
            {% if loop %}loop{% endif %}
            {% if preload %}preload="{{ preload }}"{% endif %}
            playsinline
            class="{{ this.getVideoClasses() }}"
        ></video>
        {% if hover_vid_url %}
            <video
                src="{{ hover_vid_url }}"
                {% if autoplay %}autoplay{% endif %}
                {% if muted %}muted{% endif %}
                {% if loop %}loop{% endif %}
                playsinline
                class="{{ this.getHoverVideoClasses() }}"
            ></video>
        {% endif %}
    {% endif %}
{% else %}
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <div {{ attributes.defaults(this.getRootAttributes()) }}
         {% if autoplay_mode %}data-video-autoplay="{{ autoplay_mode }}"{% endif %}>
        {% if vid_url %}
            <video
                src="{{ vid_url }}"
                {% if poster_url %}poster="{{ poster_url }}"{% endif %}
                {% if controls %}controls{% endif %}
                {% if autoplay %}autoplay{% endif %}
                {% if muted %}muted{% endif %}
                {% if loop %}loop{% endif %}
                {% if preload %}preload="{{ preload }}"{% endif %}
                playsinline
                class="{{ this.getVideoClasses() }}"
            ></video>
            {% if hover_vid_url %}
                <video
                    src="{{ hover_vid_url }}"
                    {% if autoplay %}autoplay{% endif %}
                    {% if muted %}muted{% endif %}
                    {% if loop %}loop{% endif %}
                    playsinline
                    class="{{ this.getHoverVideoClasses() }}"
                ></video>
            {% endif %}
        {% elseif poster_url %}
            <div class="relative w-full h-full">
                <twig:Image
                    :bare="true"
                    :image_url="poster_url"
                    :image_srcset="poster_srcset"
                    sizes="(min-width: 1024px) 80vw, 100vw"
                    :image_focus_style="poster_focus_style"
                    :alt="this.getPosterAlt()"
                    img_class="w-full h-full object-cover"
                />
                {% if url %}
                    <a href="{{ url }}" aria-label="{{ this.getPosterAlt()|default('Play video') }}" class="absolute inset-0 flex items-center justify-center bg-black/30 hover:bg-black/40 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-colors group">
                        <span class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-layer/90 text-primary group-hover:scale-110 group-hover:bg-layer transition-all shadow-xl">
                            {% if icon_class %}
                                <i class="{{ icon_class }} text-2xl" aria-hidden="true"></i>
                            {% else %}
                                <svg class="w-7 h-7 fill-current ml-0.5" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14l11-7z"/></svg>
                            {% endif %}
                        </span>
                    </a>
                {% endif %}
            </div>
        {% endif %}
    </div>
{% endif %}
