{# Preline UI 5 / Tailwind CSS 4 Column Component #}
<div {{ attributes.defaults({class: this.columnClasses, id: this.elementId}) }}>
    {% if this.hasBlocks %}
        <div class="w-full space-y-6">
            {% for item in this.normalizedBlocks %}
                {{ include(['blocks/' ~ item.type ~ '.html.twig', '@SuluPrelineBlocks/blocks/' ~ item.type ~ '.html.twig'], {block: item}, with_context: true, ignore_missing: true) }}
            {% endfor %}
        </div>
    {% endif %}

    {% block content %}{% endblock %}
</div>
