{# Preline UI 5 / Tailwind CSS 4 Column Component #}
{% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
<div {{ attributes.defaults(this.customAttributes|merge({class: this.columnClasses, id: this.elementId})) }}>
    {% if this.hasBlocks %}
        <div class="w-full space-y-6">
            {% for item in this.normalizedBlocks|hydrate_blocks(_context) %}
                {{ sulu_block_render(item, _context) }}
            {% endfor %}
        </div>
    {% endif %}

    {% block content %}{% endblock %}
</div>
