{% set custom_id = this.customId %}
{% set items = this.normalizedItems %}
{% set list_dom_id = custom_id ? custom_id : ('dl-' ~ random()) %}

<section
    id="{{ list_dom_id }}"
    class="w-full {{ this.marginClass }} {{ this.customClass }}"
>
    {% if title %}
        <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white">{{ title }}</h2>
        </div>
    {% endif %}

    <dl class="{{ this.listClasses }} w-full">
        {% for item in items %}
            <div class="{{ this.itemRowClasses }}">
                <dt class="{{ this.termClasses }}">
                    {% if item.icon is defined and item.icon %}
                        <span class="inline-flex items-center justify-center size-7 rounded-md bg-primary-50 text-primary-600 dark:bg-primary-950/40 dark:text-primary-400 shrink-0">
                            <i class="{{ item.icon }} text-base leading-none"></i>
                        </span>
                    {% endif %}

                    <span>{{ item.title|default('') }}</span>

                    {% if item.meta is defined and item.meta %}
                        <span class="inline-flex items-center py-0.5 px-2 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-300">
                            {{ item.meta }}
                        </span>
                    {% endif %}
                </dt>

                <dd class="{{ this.descClasses }}">
                    {% if item.content|default('') %}
                        <div class="leading-relaxed">
                            {{ item.content|raw }}
                        </div>
                    {% endif %}

                    {% set link_href = null %}
                    {% if item.link is defined and item.link %}
                        {% if item.link is iterable and item.link.url is defined %}
                            {% set link_href = item.link.url %}
                        {% elseif item.link is string %}
                            {% set link_href = item.link %}
                        {% endif %}
                    {% endif %}

                    {% if link_href %}
                        <div class="mt-2">
                            <a
                                href="{{ link_href }}"
                                class="inline-flex items-center gap-x-1 text-sm font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-500 dark:hover:text-primary-400"
                            >
                                {{ item.link_title|default('More info'|trans({}, 'sulu_website')) }}
                                <svg class="size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                        </div>
                    {% endif %}
                </dd>
            </div>
        {% endfor %}
    </dl>
</section>
