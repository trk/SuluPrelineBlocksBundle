{# Preline UI 5 / Tailwind CSS 4 Vertical Navigation Component #}
{% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
<div {% if this.elementId %}id="{{ this.elementId }}"{% endif %}
     {{ attributes.defaults(this.customAttributes|merge({class: this.getWrapperClasses('w-full my-4')})) }}>
    {% if this.title %}
        <div class="mb-3 px-3">
            <h3 class="text-sm font-bold text-foreground uppercase tracking-wider">
                {{ this.title }}
            </h3>
        </div>
    {% endif %}

    {% if this.hasItems %}
        <nav class="{{ this.navClasses }}" aria-label="{{ this.title|default('Navigation') }}">
            {% for item in this.normalizedItems %}
                {% if item.item_type == 'header' %}
                    <div class="px-3 pt-3 pb-1 text-xs font-semibold text-muted-foreground-1 uppercase tracking-wider">
                        {{ item.title }}
                    </div>
                {% elseif item.item_type == 'divider' %}
                    <hr class="my-2 border-border">
                {% else %}
                    {% set link_tag = item.link ? 'a' : 'div' %}
                    {% set active_classes = item.is_active
                        ? 'bg-primary-50 text-primary font-semibold dark:bg-primary-950/40 dark:text-primary-400'
                        : 'text-foreground hover:bg-surface focus:outline-hidden focus:bg-surface'
                    %}

                    <{{ link_tag }}
                        {% if item.link %}
                            href="{{ item.link }}"
                            {% if item.is_external %}target="_blank" rel="noopener noreferrer"{% endif %}
                        {% endif %}
                        class="flex items-center gap-x-3 py-2 px-3 rounded-lg text-sm transition-colors {{ active_classes }}">
                        {% if item.icon %}
                            <span class="shrink-0 size-4 text-current">
                                <i class="{{ item.icon }}"></i>
                            </span>
                        {% endif %}

                        <span class="grow truncate">
                            {{ item.title }}
                            {% if item.meta %}
                                <span class="block text-xs font-normal text-muted-foreground-1">
                                    {{ item.meta }}
                                </span>
                            {% endif %}
                        </span>

                        {% if item.badge %}
                            <span class="ms-auto py-0.5 px-2 inline-flex items-center text-xs font-medium bg-surface text-surface-foreground rounded-full">
                                {{ item.badge }}
                            </span>
                        {% endif %}

                        {% if item.is_external %}
                            <svg class="shrink-0 size-3.5 text-muted-foreground ms-auto" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                            </svg>
                        {% endif %}
                    </{{ link_tag }}>
                {% endif %}
            {% endfor %}
        </nav>
    {% endif %}
</div>
