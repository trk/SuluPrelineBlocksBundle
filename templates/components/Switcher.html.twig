{% set normalized_items = this.normalizedItems %}
{% set is_vert = this.isVertical %}
{% set nav_pos = this.navPosition %}
{% set switcher_uid = 'hs-switcher-' ~ random(100000, 999999) %}

{% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
<section
    {% if this.elementId %}id="{{ this.elementId }}"{% endif %}
    {{ attributes.defaults(this.customAttributes|merge({
        class: this.getWrapperClasses('w-full'),
    })) }}
>
    {% if title %}
        <h3 class="text-xl font-bold tracking-tight text-foreground mb-6">
            {{ title }}
        </h3>
    {% endif %}

    {% if is_vert %}
        <div class="grid md:grid-cols-12 gap-6 items-start">
            <div class="{% if nav_pos == 'right' %}md:order-2{% endif %} md:col-span-4">
                <nav class="{{ this.tabNavClasses }}" aria-label="Tabs" role="tablist" aria-orientation="vertical">
                    {% for item in normalized_items %}
                        {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                        {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                        {% set is_first = loop.first %}

                        <button
                            type="button"
                            class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                            id="{{ tab_id }}"
                            aria-selected="{{ is_first ? 'true' : 'false' }}"
                            data-hs-tab="#{{ panel_id }}"
                            aria-controls="{{ panel_id }}"
                            role="tab"
                        >
                            {% if item.icon|default(null) %}
                                <i class="{{ item.icon }} text-sm shrink-0"></i>
                            {% endif %}
                            <span class="truncate">{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                            {% if item.badge|default(null) %}
                                <span class="ms-auto py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground">
                                    {{ item.badge }}
                                </span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </nav>
            </div>

            <div class="{% if nav_pos == 'right' %}md:order-1{% endif %} md:col-span-8">
                <div>
                    {% for item in normalized_items %}
                        {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                        {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                        {% set is_first = loop.first %}

                        {% set link_href = item.link_href|default(null) %}
                        {% if not link_href and item.link is defined and item.link %}
                            {% if item.link.url is defined %}
                                {% set link_href = item.link.url %}
                            {% endif %}
                        {% endif %}

                        {% set img_url = item.image_url|default(null) %}
                        {% if not img_url and item.image is defined and item.image %}
                            {% if item.image.url is defined %}
                                {% set img_url = item.image.url %}
                            {% endif %}
                        {% endif %}

                        <div
                            id="{{ panel_id }}"
                            role="tabpanel"
                            aria-labelledby="{{ tab_id }}"
                            class="{% if not is_first %}hidden{% endif %} transition-opacity duration-300 bg-card border border-card-line rounded-xl p-6 shadow-2xs"
                        >
                            {% if img_url %}
                                <div class="mb-5 overflow-hidden rounded-lg">
                                    <img
                                        src="{{ img_url }}"
                                        {% if item.image_srcset|default(null) %}srcset="{{ item.image_srcset }}" sizes="(min-width: 1024px) 60vw, 100vw"{% endif %}
                                        alt="{{ item.title|default('') }}"
                                        class="w-full max-h-72 object-cover"
                                        {% if item.image_focus_style|default(null) %}style="{{ item.image_focus_style }}"{% endif %}
                                        loading="lazy"
                                    />
                                </div>
                            {% endif %}

                            {% if item.title|default(null) %}
                                <h4 class="text-lg font-bold text-foreground mb-2">
                                    {{ item.title }}
                                </h4>
                            {% endif %}

                            {% if item.content|default(null) %}
                                <div class="text-sm leading-relaxed text-muted-foreground-2">
                                    {{ item.content|raw }}
                                </div>
                            {% endif %}

                            {% if link_href %}
                                <div class="mt-4">
                                    <a
                                        href="{{ link_href }}"
                                        class="inline-flex items-center gap-x-1.5 text-sm font-semibold text-primary hover:text-primary-hover"
                                    >
                                        {{ item.link_title|default('Learn more'|trans({}, 'sulu_website')) }}
                                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>
            </div>
        </div>
    {% else %}
        <div class="flex flex-col">
            {% if nav_pos == 'top' %}
                <nav class="{{ this.tabNavClasses }} mb-4" aria-label="Tabs" role="tablist" aria-orientation="horizontal">
                    {% for item in normalized_items %}
                        {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                        {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                        {% set is_first = loop.first %}

                        <button
                            type="button"
                            class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                            id="{{ tab_id }}"
                            aria-selected="{{ is_first ? 'true' : 'false' }}"
                            data-hs-tab="#{{ panel_id }}"
                            aria-controls="{{ panel_id }}"
                            role="tab"
                        >
                            {% if item.icon|default(null) %}
                                <i class="{{ item.icon }} text-sm shrink-0"></i>
                            {% endif %}
                            <span>{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                            {% if item.badge|default(null) %}
                                <span class="ms-1.5 py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground">
                                    {{ item.badge }}
                                </span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </nav>
            {% endif %}

            <div class="w-full">
                {% for item in normalized_items %}
                    {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                    {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                    {% set is_first = loop.first %}

                    {% set link_href = item.link_href|default(null) %}
                    {% if not link_href and item.link is defined and item.link %}
                        {% if item.link.url is defined %}
                            {% set link_href = item.link.url %}
                        {% endif %}
                    {% endif %}

                    {% set img_url = item.image_url|default(null) %}
                    {% if not img_url and item.image is defined and item.image %}
                        {% if item.image.url is defined %}
                            {% set img_url = item.image.url %}
                        {% endif %}
                    {% endif %}

                    <div
                        id="{{ panel_id }}"
                        role="tabpanel"
                        aria-labelledby="{{ tab_id }}"
                        class="{% if not is_first %}hidden{% endif %} transition-opacity duration-300 bg-card border border-card-line rounded-xl p-6 shadow-2xs"
                    >
                        {% if img_url %}
                            <div class="mb-5 overflow-hidden rounded-lg">
                                <img
                                    src="{{ img_url }}"
                                    {% if item.image_srcset|default(null) %}srcset="{{ item.image_srcset }}" sizes="(min-width: 1024px) 80vw, 100vw"{% endif %}
                                    alt="{{ item.title|default('') }}"
                                    class="w-full max-h-80 object-cover"
                                    {% if item.image_focus_style|default(null) %}style="{{ item.image_focus_style }}"{% endif %}
                                    loading="lazy"
                                />
                            </div>
                        {% endif %}

                        {% if item.title|default(null) %}
                            <h4 class="text-xl font-bold text-foreground mb-2">
                                {{ item.title }}
                            </h4>
                        {% endif %}

                        {% if item.content|default(null) %}
                            <div class="text-sm leading-relaxed text-muted-foreground-2">
                                {{ item.content|raw }}
                            </div>
                        {% endif %}

                        {% if link_href %}
                            <div class="mt-4">
                                <a
                                    href="{{ link_href }}"
                                    class="inline-flex items-center gap-x-1.5 text-sm font-semibold text-primary hover:text-primary-hover"
                                >
                                    {{ item.link_title|default('Learn more'|trans({}, 'sulu_website')) }}
                                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </a>
                            </div>
                        {% endif %}
                    </div>
                {% endfor %}
            </div>

            {% if nav_pos == 'bottom' %}
                <nav class="{{ this.tabNavClasses }} mt-4" aria-label="Tabs" role="tablist" aria-orientation="horizontal">
                    {% for item in normalized_items %}
                        {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                        {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                        {% set is_first = loop.first %}

                        <button
                            type="button"
                            class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                            id="{{ tab_id }}"
                            aria-selected="{{ is_first ? 'true' : 'false' }}"
                            data-hs-tab="#{{ panel_id }}"
                            aria-controls="{{ panel_id }}"
                            role="tab"
                        >
                            {% if item.icon|default(null) %}
                                <i class="{{ item.icon }} text-sm shrink-0"></i>
                            {% endif %}
                            <span>{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                            {% if item.badge|default(null) %}
                                <span class="ms-1.5 py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground">
                                    {{ item.badge }}
                                </span>
                            {% endif %}
                        </button>
                    {% endfor %}
                </nav>
            {% endif %}
        </div>
    {% endif %}
</section>
