{% set title = this.title %}
{% set normalized_items = this.normalizedItems %}
{% set is_vert = this.isVertical %}
{% set nav_pos = this.navPosition %}
{% set vertical_split = this.verticalSplit %}
{% set image_sizes = this.imageSizes %}
{% set image_dimensions = this.intrinsicImageDimensions %}
{% set media_frame_classes = this.mediaFrameClasses %}
{% set media_img_classes = this.mediaImgClasses %}
{% set media_aspect_style = this.mediaAspectRatioStyle %}
{% set switcher_uid = this.componentUid %}

<div {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <div class="{{ this.blockClasses }}">
        {% if title %}
            <h3 class="text-xl font-bold tracking-tight text-foreground mb-6">
                {{ title }}
            </h3>
        {% endif %}

        {% if is_vert %}
            <div class="{{ vertical_split.grid }}">
                <div class="{{ nav_pos == 'right' ? vertical_split.nav_end }} {{ vertical_split.nav }}">
                    <nav class="{{ this.tabNavClasses }}" aria-label="Tabs" role="tablist" aria-orientation="vertical">
                        {% for item in normalized_items %}
                            {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                            {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                            {% set is_first = loop.first %}

                            <button
                                type="button"
                                class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                                id="{{ tab_id }}"
                                aria-selected="{{ is_first ? 'true' : 'false' }}"
                                data-hs-tab="#{{ panel_id }}"
                                aria-controls="{{ panel_id }}"
                                role="tab"
                            >
                                {% if item.icon|default(null) %}
                                    <i class="{{ item.icon }} text-sm shrink-0"></i>
                                {% endif %}
                                <span class="truncate">{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                                {% if item.badge|default(null) %}
                                    <twig:Badge
                                        :title="item.badge"
                                        classes="ms-auto py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground"
                                    />
                                {% endif %}
                            </button>
                        {% endfor %}
                    </nav>
                </div>

                <div class="{{ nav_pos == 'right' ? vertical_split.panel_end }} {{ vertical_split.panel }}">
                    <div>
                        {% for item in normalized_items %}
                            {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                            {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                            {% set is_first = loop.first %}
                            {% set link_href = item.link_href|default(null) %}
                            {% set img_url = item.image_url|default(null) %}

                            <div
                                id="{{ panel_id }}"
                                role="tabpanel"
                                aria-labelledby="{{ tab_id }}"
                                class="{% if not is_first %}hidden{% endif %} transition-opacity duration-300 bg-card border border-card-line rounded-xl p-6 shadow-2xs"
                            >
                                {% if img_url %}
                                    <div class="mb-5 {{ media_frame_classes }} rounded-lg" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
                                        <twig:Image
                                            :bare="true"
                                            :image_url="img_url"
                                            :image_srcset="item.image_srcset|default(null)"
                                            :sizes="image_sizes"
                                            :dimensions="image_dimensions"
                                            :image_focus_style="item.image_focus_style|default(null)"
                                            :alt="item.title|default('')"
                                            :loading="this.getImageLoading(is_first)"
                                            :fetchpriority="this.getImageFetchPriority(is_first, not is_first)"
                                            :img_class="media_img_classes"
                                        />
                                    </div>
                                {% endif %}

                                {% if item.title|default(null) %}
                                    <h4 class="text-lg font-bold text-foreground mb-2">
                                        {{ item.title }}
                                    </h4>
                                {% endif %}

                                {% if item.content|default(null) %}
                                    <div class="text-sm leading-relaxed text-muted-foreground-2">
                                        {{ item.content|raw }}
                                    </div>
                                {% endif %}

                                {% if link_href and link_href != '#' %}
                                    <div class="mt-4">
                                        <a
                                            href="{{ link_href }}"
                                            {% if item.link_target|default(null) == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}
                                            {% if item.link_title|default(null) %}title="{{ item.link_title }}"{% endif %}
                                            class="inline-flex items-center gap-x-1.5 text-sm font-semibold text-primary hover:text-primary-hover"
                                        >
                                            {{ item.link_title|default('Learn more'|trans({}, 'sulu_website')) }}
                                            <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                        </a>
                                    </div>
                                {% endif %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="flex flex-col">
                {% if nav_pos == 'top' %}
                    <nav class="{{ this.tabNavClasses }} mb-4" aria-label="Tabs" role="tablist" aria-orientation="horizontal">
                        {% for item in normalized_items %}
                            {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                            {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                            {% set is_first = loop.first %}

                            <button
                                type="button"
                                class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                                id="{{ tab_id }}"
                                aria-selected="{{ is_first ? 'true' : 'false' }}"
                                data-hs-tab="#{{ panel_id }}"
                                aria-controls="{{ panel_id }}"
                                role="tab"
                            >
                                {% if item.icon|default(null) %}
                                    <i class="{{ item.icon }} text-sm shrink-0"></i>
                                {% endif %}
                                <span>{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                                {% if item.badge|default(null) %}
                                    <twig:Badge
                                        :title="item.badge"
                                        classes="ms-1.5 py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground"
                                    />
                                {% endif %}
                            </button>
                        {% endfor %}
                    </nav>
                {% endif %}

                <div class="w-full">
                    {% for item in normalized_items %}
                        {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                        {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                        {% set is_first = loop.first %}
                        {% set link_href = item.link_href|default(null) %}
                        {% set img_url = item.image_url|default(null) %}

                        <div
                            id="{{ panel_id }}"
                            role="tabpanel"
                            aria-labelledby="{{ tab_id }}"
                            class="{% if not is_first %}hidden{% endif %} transition-opacity duration-300 bg-card border border-card-line rounded-xl p-6 shadow-2xs"
                        >
                            {% if img_url %}
                                <div class="mb-5 {{ media_frame_classes }} rounded-lg" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
                                    <twig:Image
                                        :bare="true"
                                        :image_url="img_url"
                                        :image_srcset="item.image_srcset|default(null)"
                                        :sizes="image_sizes"
                                        :dimensions="image_dimensions"
                                        :image_focus_style="item.image_focus_style|default(null)"
                                        :alt="item.title|default('')"
                                        :loading="this.getImageLoading(is_first)"
                                        :fetchpriority="this.getImageFetchPriority(is_first, not is_first)"
                                        :img_class="media_img_classes"
                                    />
                                </div>
                            {% endif %}

                            {% if item.title|default(null) %}
                                <h4 class="text-xl font-bold text-foreground mb-2">
                                    {{ item.title }}
                                </h4>
                            {% endif %}

                            {% if item.content|default(null) %}
                                <div class="text-sm leading-relaxed text-muted-foreground-2">
                                    {{ item.content|raw }}
                                </div>
                            {% endif %}

                            {% if link_href and link_href != '#' %}
                                <div class="mt-4">
                                    <a
                                        href="{{ link_href }}"
                                        {% if item.link_target|default(null) == '_blank' %}target="_blank" rel="noopener noreferrer"{% endif %}
                                        {% if item.link_title|default(null) %}title="{{ item.link_title }}"{% endif %}
                                        class="inline-flex items-center gap-x-1.5 text-sm font-semibold text-primary hover:text-primary-hover"
                                    >
                                        {{ item.link_title|default('Learn more'|trans({}, 'sulu_website')) }}
                                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    {% endfor %}
                </div>

                {% if nav_pos == 'bottom' %}
                    <nav class="{{ this.tabNavClasses }} mt-4" aria-label="Tabs" role="tablist" aria-orientation="horizontal">
                        {% for item in normalized_items %}
                            {% set tab_id = switcher_uid ~ '-tab-' ~ loop.index %}
                            {% set panel_id = switcher_uid ~ '-panel-' ~ loop.index %}
                            {% set is_first = loop.first %}

                            <button
                                type="button"
                                class="{{ this.tabButtonClasses }} {% if is_first %}active{% endif %}"
                                id="{{ tab_id }}"
                                aria-selected="{{ is_first ? 'true' : 'false' }}"
                                data-hs-tab="#{{ panel_id }}"
                                aria-controls="{{ panel_id }}"
                                role="tab"
                            >
                                {% if item.icon|default(null) %}
                                    <i class="{{ item.icon }} text-sm shrink-0"></i>
                                {% endif %}
                                <span>{{ item.nav_title|default(item.title|default('Tab ' ~ loop.index)) }}</span>
                                {% if item.badge|default(null) %}
                                    <twig:Badge
                                        :title="item.badge"
                                        classes="ms-1.5 py-0.5 px-2 text-xs font-semibold rounded-full bg-surface text-surface-foreground"
                                    />
                                {% endif %}
                            </button>
                        {% endfor %}
                    </nav>
                {% endif %}
            </div>
        {% endif %}
    </div>
</div>
