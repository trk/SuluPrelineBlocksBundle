{% set title = this.title %}
{% set target_href = this.getTargetHref() %}
{% set icon_class = this.getResolvedIcon() %}
{% set mode = this.getDisplayMode() %}
{% set btn_classes = this.getButtonClasses() %}
{% set icon_pos = this.getResolvedProps()['icon_position']|default('left') %}
{% set is_top = this.isTop() %}
{% set default_label = is_top ? 'Scroll to top' : 'Scroll down' %}
{% set aria_text = title|default(default_label) %}

<div {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <div class="{{ this.blockClasses }}">
        <a href="{{ target_href }}"
           class="{{ btn_classes }}"
           aria-label="{{ aria_text }}"
           data-hs-scroll>

            {% if mode == 'totop_circle' or mode == 'floating' %}
                {# Circle Icon Only #}
                <i class="{{ icon_class }} text-xl" aria-hidden="true"></i>
            {% else %}
                {# Button with optional title & icon #}
                {% if icon_pos == 'left' and icon_class %}
                    <i class="{{ icon_class }} text-base" aria-hidden="true"></i>
                {% endif %}

                {% if title %}
                    <span>{{ title }}</span>
                {% else %}
                    <span class="sr-only">{{ aria_text }}</span>
                    {% if icon_pos != 'left' and icon_class %}
                        <i class="{{ icon_class }} text-base" aria-hidden="true"></i>
                    {% endif %}
                {% endif %}

                {% if icon_pos == 'right' and icon_class and title %}
                    <i class="{{ icon_class }} text-base" aria-hidden="true"></i>
                {% endif %}
            {% endif %}
        </a>
    </div>
</div>
