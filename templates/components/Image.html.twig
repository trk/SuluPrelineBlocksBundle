{% set img_url = this.getImageUrl() %}
{% set img_srcset = this.getImageSrcSet() %}
{% set img_sizes = this.getImageSizes() %}
{% set img_focus_style = this.getImageFocusPointStyle() %}
{% set hover_img_url = this.getHoverImageUrl() %}
{% set hover_img_srcset = this.getHoverImageSrcSet() %}
{% set hover_focus_style = this.getHoverImageFocusPointStyle() %}
{% set dimensions = this.getDimensions() %}
{% set loading = this.getLoading() %}
{% set fetchpriority = this.getFetchPriority() %}

{% macro picture(src, srcset, sizes, alt, class, style, loading, dimensions, fetchpriority = null) %}
    <img
        src="{{ src }}"
        {% if srcset %}srcset="{{ srcset }}" sizes="{{ sizes }}"{% endif %}
        {% if dimensions %}width="{{ dimensions.width }}" height="{{ dimensions.height }}"{% endif %}
        alt="{{ alt }}"
        class="{{ class }}"
        {% if style %}style="{{ style }}"{% endif %}
        loading="{{ loading }}"
        {% if fetchpriority %}fetchpriority="{{ fetchpriority }}"{% endif %}
        decoding="async"
    />
{% endmacro %}
{% import _self as image_macros %}

{% set images %}
    {{ image_macros.picture(img_url, img_srcset, img_sizes, this.getAlt(), this.getImgClasses(), img_focus_style, loading, dimensions, fetchpriority) }}
    {% if hover_img_url %}
        {{ image_macros.picture(hover_img_url, hover_img_srcset, img_sizes, this.getHoverAlt(), this.getHoverImgClasses(), hover_focus_style, 'lazy', dimensions, 'low') }}
    {% endif %}
{% endset %}

{% if img_url %}
    {% if this.isBare() %}
        {{ images }}
    {% else %}
        {% set url = this.getUrl() %}
        {% set caption = this.getCaption() %}
        {% set aspect_style = this.getMediaAspectRatioStyle() %}
        <div {{ attributes.defaults(this.getRootAttributes()) }}>
            {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
            <div class="{{ this.blockClasses }}">
                <figure class="block w-full">
                    {% if url %}
                        <a href="{{ url }}" class="{{ this.getMediaContainerClasses() }} focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary" {% if aspect_style %}style="{{ aspect_style }}"{% endif %}>
                            {{ images }}
                        </a>
                    {% else %}
                        <div class="{{ this.getMediaContainerClasses() }}" {% if aspect_style %}style="{{ aspect_style }}"{% endif %}>
                            {{ images }}
                        </div>
                    {% endif %}

                    {% if caption %}
                        <figcaption class="mt-2 text-sm text-center text-muted-foreground-1">
                            {{ caption }}
                        </figcaption>
                    {% endif %}
                </figure>
            </div>
        </div>
    {% endif %}
{% endif %}
