{% set normalized_items = this.normalizedItems %}

<nav
    {% if this.customId %}id="{{ this.customId }}"{% endif %}
    class="w-full {{ this.marginClass }} {{ this.customClass }}"
    aria-label="{{ title|default('Sub navigation'|trans({}, 'sulu_website')) }}"
>
    {% if title %}
        <h3 class="text-sm font-semibold uppercase tracking-wider text-gray-500 dark:text-neutral-400 mb-2.5">
            {{ title }}
        </h3>
    {% endif %}

    <div class="{{ this.navClasses }}">
        {% for item in normalized_items %}
            {% set link_href = item.link_href|default(null) %}
            {% if not link_href and item.link is defined and item.link %}
                {% if item.link is iterable %}
                    {% set link_href = item.link.url|default(null) %}
                {% else %}
                    {% set link_href = item.link %}
                {% endif %}
            {% endif %}

            {% set is_active = item.is_active|default(false) %}

            {% if link_href %}
                <a
                    href="{{ link_href }}"
                    class="{{ this.itemClasses(is_active) }}"
                    {% if is_active %}aria-current="page"{% endif %}
                >
                    {% if item.icon|default(null) %}
                        <i class="{{ item.icon }} text-sm"></i>
                    {% endif %}
                    <span>{{ item.title|default('') }}</span>
                    {% if item.badge|default(null) %}
                        <span class="py-0.5 px-1.5 text-2xs font-semibold rounded-full {% if is_active %}bg-white/20 text-white{% else %}bg-gray-200 text-gray-700 dark:bg-neutral-700 dark:text-neutral-300{% endif %}">
                            {{ item.badge }}
                        </span>
                    {% endif %}
                </a>
            {% else %}
                <span class="{{ this.itemClasses(is_active) }}">
                    {% if item.icon|default(null) %}
                        <i class="{{ item.icon }} text-sm"></i>
                    {% endif %}
                    <span>{{ item.title|default('') }}</span>
                    {% if item.badge|default(null) %}
                        <span class="py-0.5 px-1.5 text-2xs font-semibold rounded-full {% if is_active %}bg-white/20 text-white{% else %}bg-gray-200 text-gray-700 dark:bg-neutral-700 dark:text-neutral-300{% endif %}">
                            {{ item.badge }}
                        </span>
                    {% endif %}
                </span>
            {% endif %}
        {% endfor %}
    </div>
</nav>
