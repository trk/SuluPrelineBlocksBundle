<div {{ attributes.defaults({ class: this.containerClasses }) }}>
    <div class="{{ this.headerClasses }}">
        <div class="flex items-center gap-x-2">
            <span class="inline-block size-3 rounded-full bg-red-500/80"></span>
            <span class="inline-block size-3 rounded-full bg-yellow-500/80"></span>
            <span class="inline-block size-3 rounded-full bg-green-500/80"></span>
            {% if this.title %}
                <span class="ms-2 font-mono text-xs text-neutral-300 font-semibold">{{ this.title }}</span>
            {% endif %}
        </div>
        <div class="flex items-center gap-x-3">
            <span class="px-2 py-0.5 rounded-md bg-neutral-800 text-[11px] font-medium text-neutral-300 uppercase tracking-wider">{{ this.languageLabel }}</span>
            {% if this.show_copy %}
                <button type="button" class="js-clipboard inline-flex items-center gap-x-1.5 py-1 px-2.5 rounded-lg text-xs text-neutral-300 hover:text-white bg-neutral-800 hover:bg-neutral-700 transition focus:outline-hidden" data-hs-clipboard='{"content": "#{{ this.id }}"}'>
                    <svg class="js-clipboard-default size-3.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                    <svg class="js-clipboard-success hidden size-3.5 text-primary-400" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                    <span class="js-clipboard-default">Copy</span>
                    <span class="js-clipboard-success hidden text-primary-400">Copied!</span>
                </button>
            {% endif %}
        </div>
    </div>
    <div class="relative">
        <pre class="{{ this.preClasses }}"><code id="{{ this.id }}" class="language-{{ this.language }} block font-mono">{% if this.show_line_numbers %}<table class="border-collapse w-full">{% for line in this.lines %}<tr><td class="select-none pe-4 text-end text-neutral-600 font-mono text-xs w-8">{{ loop.index }}</td><td class="whitespace-pre font-mono">{{ line }}</td></tr>{% endfor %}</table>{% else %}{{ this.code }}{% endif %}</code></pre>
    </div>
</div>
