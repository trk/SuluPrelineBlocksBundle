{% set custom_id = this.customId %}
{% set items = this.normalizedItems %}
{% set is_filter_active = this.isFilterEnabled() and this.filterTags|length > 0 %}
{% set is_lightbox_active = this.isLightboxEnabled() %}
{% set gallery_dom_id = custom_id ? custom_id : ('gallery-' ~ random()) %}

<section
    id="{{ gallery_dom_id }}"
    class="w-full {{ this.marginClass }} {{ this.customClass }}"
>
    {% if title %}
        <div class="mb-8 text-center">
            <h2 class="text-2xl sm:text-3xl font-bold text-foreground">{{ title }}</h2>
        </div>
    {% endif %}

    {% if is_filter_active %}
        <div class="mb-8 flex flex-wrap gap-2 {{ this.filterAlignClass }}">
            <button
                type="button"
                data-filter="*"
                class="active filter-btn py-2 px-3.5 inline-flex items-center text-sm font-medium rounded-lg border border-transparent bg-primary text-primary-foreground hover:bg-primary-hover focus:outline-hidden disabled:opacity-50 transition"
            >
                {{ this.resolvedProps.filter_all_label|default('All') }}
            </button>
            {% for slug, label in this.filterTags %}
                <button
                    type="button"
                    data-filter="{{ slug }}"
                    class="filter-btn py-2 px-3.5 inline-flex items-center text-sm font-medium rounded-lg border border-layer-line bg-layer text-layer-foreground shadow-2xs hover:bg-layer-hover focus:outline-hidden disabled:opacity-50 transition"
                >
                    {{ label }}
                </button>
            {% endfor %}
        </div>
    {% endif %}

    <div class="{{ this.containerClasses }} gallery-container w-full">
        {% for item in items %}
            {% set item_tags = this.getItemTagSlugs(item) %}
            {% set image_url = this.resolveItemImageUrl(item) %}
            {% set image_srcset = this.resolveItemImageSrcSet(item) %}
            {% set image_focus_style = this.resolveItemImageFocusPointStyle(item) %}
            {% set modal_id = gallery_dom_id ~ '-modal-' ~ loop.index %}
            {% set item_props = this.resolveItemProps(item) %}

            <div
                class="gallery-item-card w-full {% if this.isMasonry() %}break-inside-avoid mb-6 inline-block{% else %}h-full flex flex-col{% endif %} transition-all duration-300 ease-in-out"
                data-tags="{{ item_tags }}"
            >
                <div class="w-full h-full flex flex-col {% if is_lightbox_active and image_url and not item.link|default(null) %}cursor-pointer{% endif %}" {% if is_lightbox_active and image_url and not item.link|default(null) %}data-hs-overlay="#{{ modal_id }}"{% endif %}>
                    <twig:Overlay
                        title="{{ item.title|default(null) }}"
                        meta="{{ item.meta|default(null) }}"
                        badge="{{ item.badge|default(null) }}"
                        content="{{ item.summary|default(item.content|default(null)) }}"
                        :image="item.image|default(null)"
                        :video="item.video|default(null)"
                        :icon="item.icon|default(null)"
                        :link="item.link|default(item.url|default(null))"
                        linkTitle="{{ item.link_title|default(null) }}"
                        :hoverImage="item.hover_image|default(null)"
                        :hoverVideo="item.hover_video|default(null)"
                        :props="item_props"
                        class="w-full h-full flex-1"
                    />
                </div>
            </div>

            {% if is_lightbox_active and image_url %}
                <div
                    id="{{ modal_id }}"
                    class="hs-overlay hidden ti-modal fixed inset-0 z-80 overflow-x-hidden overflow-y-auto pointer-events-none"
                    role="dialog"
                    tabindex="-1"
                    aria-labelledby="{{ modal_id }}-label"
                >
                    <div class="hs-overlay-open:opacity-100 hs-overlay-open:duration-500 opacity-0 transition-all sm:max-w-4xl sm:w-full m-3 sm:mx-auto min-h-[calc(100%-3.5rem)] flex items-center">
                        <div class="w-full flex flex-col bg-overlay border border-overlay-line shadow-xl rounded-2xl pointer-events-auto overflow-hidden">
                            <div class="flex justify-between items-center py-3 px-4 border-b border-overlay-divider bg-overlay-header">
                                <h3 id="{{ modal_id }}-label" class="font-bold text-foreground">
                                    {{ item.title|default('') }}
                                </h3>
                                <button
                                    type="button"
                                    class="size-8 inline-flex justify-center items-center gap-x-2 rounded-full border border-transparent bg-surface text-surface-foreground hover:bg-surface-hover focus:outline-hidden disabled:opacity-50"
                                    aria-label="Close"
                                    data-hs-overlay="#{{ modal_id }}"
                                >
                                    <span class="sr-only">Close</span>
                                    <svg class="shrink-0 size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                                </button>
                            </div>
                            <div class="p-4 overflow-y-auto text-center bg-black/5 dark:bg-black/40">
                                <img
                                    class="max-h-[75vh] mx-auto object-contain rounded-lg"
                                    src="{{ image_url }}"
                                    {% if image_srcset %}srcset="{{ image_srcset }}" sizes="(min-width: 1024px) 80vw, 100vw"{% endif %}
                                    alt="{{ item.title|default('') }}"
                                    {% if image_focus_style %}style="{{ image_focus_style }}"{% endif %}
                                    loading="lazy"
                                >
                                {% set modal_content = item.summary|default(item.content|default(null)) %}
                                {% if modal_content %}
                                    <div class="mt-4 text-left text-sm text-muted-foreground-2">
                                        {{ modal_content|raw }}
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </div>
            {% endif %}
        {% endfor %}
    </div>

    {% if is_filter_active %}
        <script>
            (function() {
                var scope = document.getElementById('{{ gallery_dom_id }}');
                if (!scope) return;
                var btns = scope.querySelectorAll('.filter-btn');
                var items = scope.querySelectorAll('.gallery-item-card');

                btns.forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        var filter = this.getAttribute('data-filter');

                        btns.forEach(function(b) {
                            b.classList.remove('bg-primary', 'text-primary-foreground', 'hover:bg-primary-hover', 'border-transparent', 'active');
                            b.classList.add('bg-layer', 'text-layer-foreground', 'border-layer-line', 'hover:bg-layer-hover');
                        });

                        this.classList.remove('bg-layer', 'text-layer-foreground', 'border-layer-line', 'hover:bg-layer-hover');
                        this.classList.add('bg-primary', 'text-primary-foreground', 'hover:bg-primary-hover', 'border-transparent', 'active');

                        items.forEach(function(item) {
                            var tags = (item.getAttribute('data-tags') || '').split(' ');
                            if (filter === '*' || tags.indexOf(filter) !== -1) {
                                item.style.display = '';
                                item.style.opacity = '1';
                            } else {
                                item.style.display = 'none';
                                item.style.opacity = '0';
                            }
                        });

                        if (typeof window.HSStaticMethods !== 'undefined') {
                            window.HSStaticMethods.autoInit();
                        }
                    });
                });
            })();
        </script>
    {% endif %}
</section>
