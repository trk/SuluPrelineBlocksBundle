{# Preline UI 5 / Tailwind CSS 4 Map Component #}
<div {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <div class="{{ this.blockClasses }}">
        {% if this.title %}
            <div class="mb-4">
                <h3 class="text-xl font-bold text-foreground">{{ this.title }}</h3>
            </div>
        {% endif %}

        {% if this.hasMap %}
            <div class="{{ this.mapFrameClasses }} {{ this.aspectRatioClasses }}">
                <iframe
                    src="{{ this.embedUrl }}"
                    class="w-full h-full border-0"
                    loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    allowfullscreen
                    title="{{ this.title|default('Interactive Map') }}">
                </iframe>
            </div>
        {% else %}
            <div class="p-8 text-center bg-surface rounded-2xl border border-dashed border-border">
                <p class="text-sm text-muted-foreground-1">No map location provided.</p>
            </div>
        {% endif %}

        {% if this.hasItems %}
            <div class="mt-6 gap-4 {{ this.itemGridClasses }}">
                {% set item_image_sizes = this.itemImageSizes %}
                {% for item in this.normalizedItems %}
                    <div class="flex flex-col bg-card border border-card-line rounded-xl p-4 md:p-5 shadow-xs transition hover:shadow-md">
                        {% if item.image_url %}
                            <div class="mb-3 rounded-lg overflow-hidden aspect-video bg-surface">
                                <twig:Image
                                    :bare="true"
                                    :image_url="item.image_url"
                                    :image_srcset="item.image_srcset"
                                    :sizes="item_image_sizes"
                                    :image_focus_style="item.image_focus_style"
                                    :alt="item.title|default(item.location)"
                                    :loading="this.getImageLoading(loop.first)"
                                    :fetchpriority="this.getImageFetchPriority(loop.first)"
                                    img_class="w-full h-full object-cover"
                                />
                            </div>
                        {% endif %}

                        {% if item.title %}
                            <h4 class="text-base font-semibold text-foreground">
                                {{ item.title }}
                            </h4>
                        {% endif %}

                        {% if item.meta %}
                            <p class="text-xs font-medium text-muted-foreground-1 mt-1">
                                {{ item.meta }}
                            </p>
                        {% endif %}

                        <div class="flex items-start gap-1.5 text-xs text-muted-foreground-2 mt-2">
                            <svg class="shrink-0 size-4 text-primary mt-0.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 10.5a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                                <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 10.5c0 7.142-7.5 11.25-7.5 11.25S4.5 17.642 4.5 10.5a7.5 7.5 0 1 1 15 0Z" />
                            </svg>
                            <span>{{ item.location }}</span>
                        </div>

                        {% if item.content %}
                            <div class="mt-2 text-xs text-muted-foreground-2 prose prose-xs dark:prose-invert">
                                {{ item.content|raw }}
                            </div>
                        {% endif %}

                        <div class="mt-auto pt-4 flex flex-wrap items-center gap-2">
                            <a
                                href="{{ item.directions_url }}"
                                target="_blank"
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-x-1.5 py-1.5 px-2.5 rounded-lg text-xs font-medium bg-primary text-primary-foreground hover:bg-primary-hover focus:outline-hidden focus:ring-2 focus:ring-primary transition-colors">
                                <svg class="shrink-0 size-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 6.75V15m6-6v8.25m.503 3.498 4.875-2.437c.381-.19.622-.58.622-1.006V4.82c0-.836-.88-1.38-1.628-1.006l-3.869 1.934c-.317.159-.69.159-1.006 0L9.503 3.252a1.125 1.125 0 0 0-1.006 0L3.622 5.689A1.125 1.125 0 0 0 3 6.695V19.18c0 .836.88 1.38 1.628 1.006l3.869-1.934c.317-.159.69-.159 1.006 0l4.994 2.497c.317.158.69.158 1.006 0Z" />
                                </svg>
                                Directions
                            </a>

                            {% if item.link %}
                                <twig:Button
                                    :bare="true"
                                    :title="item.link_title"
                                    :url="item.link"
                                    icon="arrow-right"
                                    icon_align="right"
                                    variant="white"
                                    size="xs"
                                />
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</div>
