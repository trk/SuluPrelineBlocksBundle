{% set normalized_items = this.normalizedItems %}
{% set arrows = this.arrows %}
{% set indicators = this.indicators %}
{% set height_class = this.heightClass %}
{% set align_class = this.contentAlign %}

<section
    {% if this.customId %}id="{{ this.customId }}"{% endif %}
    class="relative w-full {{ this.marginClass }} {{ this.customClass }}"
>
    {% if title %}
        <div class="mb-6">
            <h3 class="text-2xl font-bold tracking-tight text-gray-900 dark:text-white">
                {{ title }}
            </h3>
        </div>
    {% endif %}

    <div
        data-hs-carousel='{{ this.carouselConfigJson|raw }}'
        class="relative w-full"
    >
        <div class="hs-carousel relative overflow-hidden w-full {{ height_class }} rounded-2xl bg-neutral-900">
            <div class="hs-carousel-body absolute top-0 bottom-0 start-0 flex flex-nowrap transition-transform duration-700 opacity-0">
                {% for item in normalized_items %}
                    {% set img_url = item.image_url|default(null) %}
                    {% if not img_url and item.image is defined and item.image %}
                        {% if item.image is iterable %}
                            {% set img_url = item.image.url|default(null) %}
                        {% else %}
                            {% set img_url = item.image %}
                        {% endif %}
                    {% endif %}

                    {% set link_href = item.link_href|default(null) %}
                    {% if not link_href and item.link is defined and item.link %}
                        {% if item.link is iterable %}
                            {% set link_href = item.link.url|default(null) %}
                        {% else %}
                            {% set link_href = item.link %}
                        {% endif %}
                    {% endif %}

                    {% set overlay = item.overlay_style|default('dark_medium') %}

                    <div class="hs-carousel-slide relative w-full h-full flex flex-col justify-center overflow-hidden">
                        {% if img_url %}
                            <img
                                src="{{ img_url }}"
                                alt="{{ item.title|default('') }}"
                                class="absolute inset-0 w-full h-full object-cover"
                                loading="lazy"
                            />
                        {% endif %}

                        {# Overlay tint #}
                        {% if overlay == 'dark_soft' %}
                            <div class="absolute inset-0 bg-black/30"></div>
                        {% elseif overlay == 'dark_strong' %}
                            <div class="absolute inset-0 bg-black/70"></div>
                        {% elseif overlay == 'gradient' %}
                            <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/40 to-transparent"></div>
                        {% elseif overlay != 'none' %}
                            <div class="absolute inset-0 bg-black/50"></div>
                        {% endif %}

                        {# Content layer #}
                        <div class="relative z-10 max-w-4xl mx-auto px-6 sm:px-12 py-12 flex flex-col {{ align_class }}">
                            {% if item.meta|default(null) %}
                                <span class="inline-block text-xs sm:text-sm font-semibold uppercase tracking-wider text-primary-300 mb-2">
                                    {{ item.meta }}
                                </span>
                            {% endif %}

                            {% if item.title|default(null) %}
                                <h2 class="text-2xl sm:text-4xl md:text-5xl font-black text-white tracking-tight leading-tight mb-4">
                                    {{ item.title }}
                                </h2>
                            {% endif %}

                            {% if item.content|default(null) %}
                                <div class="text-sm sm:text-base md:text-lg text-neutral-200 leading-relaxed max-w-2xl mb-6">
                                    {{ item.content|raw }}
                                </div>
                            {% endif %}

                            {% if link_href %}
                                <div>
                                    <a
                                        href="{{ link_href }}"
                                        class="inline-flex items-center gap-x-2 py-3 px-6 rounded-xl font-semibold text-sm bg-primary-600 text-white hover:bg-primary-700 shadow-md shadow-primary-500/20 active:scale-95 transition-all focus:outline-hidden"
                                    >
                                        <span>{{ item.link_title|default('Discover more'|trans({}, 'sulu_website')) }}</span>
                                        <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if arrows != 'none' %}
            <button
                type="button"
                class="hs-carousel-prev hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 start-0 inline-flex justify-center items-center w-12 h-12 my-auto text-white bg-black/40 backdrop-blur-xs hover:bg-black/70 rounded-full shadow-lg z-20 focus:outline-hidden transition-all {% if arrows == 'outside' %}-start-5{% else %}start-4{% endif %}"
                aria-label="Previous"
            >
                <span class="text-2xl" aria-hidden="true">
                    <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="sr-only">Previous</span>
            </button>
            <button
                type="button"
                class="hs-carousel-next hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 end-0 inline-flex justify-center items-center w-12 h-12 my-auto text-white bg-black/40 backdrop-blur-xs hover:bg-black/70 rounded-full shadow-lg z-20 focus:outline-hidden transition-all {% if arrows == 'outside' %}-end-5{% else %}end-4{% endif %}"
                aria-label="Next"
            >
                <span class="text-2xl" aria-hidden="true">
                    <svg class="size-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6 6-6"/></svg>
                </span>
                <span class="sr-only">Next</span>
            </button>
        {% endif %}

        {% if indicators != 'none' %}
            <div class="hs-carousel-pagination flex justify-center items-center gap-x-2 absolute bottom-5 start-0 end-0 z-20">
                {% for item in normalized_items %}
                    {% if indicators == 'lines' %}
                        <span class="hs-carousel-active:bg-white hs-carousel-active:w-8 w-4 h-1 bg-white/50 rounded-full cursor-pointer transition-all duration-300"></span>
                    {% else %}
                        <span class="hs-carousel-active:bg-primary-500 hs-carousel-active:scale-125 size-2.5 bg-white/60 rounded-full cursor-pointer transition-all duration-300"></span>
                    {% endif %}
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
