{% set url = this.getUrl() %}
{% set icon = this.getResolvedIcon() %}
{% set icon_align = this.getIconAlign() %}
{% set title = this.getTitle() %}
{% set link_title = this.getLinkTitle() %}

{% if this.isClickable() %}
    <a href="{{ url }}"
       {% if link_title %}title="{{ link_title }}"{% endif %}
       {{ attributes.defaults(this.getRootAttributes('hover:opacity-80 focus:outline-hidden transition-opacity')) }}
    >
        {% if this.hasDot() %}
            <span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>
        {% endif %}
        {% if icon and icon_align == 'left' %}
            <i class="{{ icon }} shrink-0" aria-hidden="true"></i>
        {% endif %}
        {% if title %}
            <span>{{ title }}</span>
        {% endif %}
        {% if icon and icon_align == 'right' %}
            <i class="{{ icon }} shrink-0" aria-hidden="true"></i>
        {% endif %}
    </a>
{% else %}
    <span {{ attributes.defaults(this.getRootAttributes()) }}>
        {% if this.hasDot() %}
            <span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>
        {% endif %}
        {% if icon and icon_align == 'left' %}
            <i class="{{ icon }} shrink-0" aria-hidden="true"></i>
        {% endif %}
        {% if title %}
            <span>{{ title }}</span>
        {% endif %}
        {% if icon and icon_align == 'right' %}
            <i class="{{ icon }} shrink-0" aria-hidden="true"></i>
        {% endif %}
    </span>
{% endif %}
