{# Preline UI 5 / Tailwind CSS 4 Section Container Component #}
{% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
<section {{ attributes.defaults(this.customAttributes|merge({class: this.sectionClasses, id: this.elementId})) }}>
    <div class="{{ this.containerClasses }} relative z-10">
        {% if this.hasRows %}
            <div class="space-y-8">
                {% for row in this.normalizedRows %}
                    <twig:Row
                        :columns="row.columns|default([])"
                        :props="row"
                        :context="this.context"
                    />
                {% endfor %}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </div>
</section>
