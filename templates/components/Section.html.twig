{# Preline UI 5 / Tailwind CSS 4 Section Container Component #}
<section {{ attributes.defaults({class: this.sectionClasses, id: this.elementId}) }}>
    <div class="{{ this.containerClasses }} relative z-10">
        {% if this.hasRows %}
            <div class="space-y-8">
                {% for row in this.normalizedRows %}
                    <twig:Row
                        :columns="row.columns|default([])"
                        :props="row"
                    />
                {% endfor %}
            </div>
        {% endif %}

        {% block content %}{% endblock %}
    </div>
</section>
