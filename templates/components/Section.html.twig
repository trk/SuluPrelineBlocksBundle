{# Preline UI 5 / Tailwind CSS 4 Section Component #}
<section {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <twig:Container
        :rows="this.rows"
        :props="this.containerProps"
        :context="this.context"
    >
        {% if outerBlocks is defined and outerBlocks.content is defined %}{{ block(outerBlocks.content) }}{% endif %}
    </twig:Container>
</section>
