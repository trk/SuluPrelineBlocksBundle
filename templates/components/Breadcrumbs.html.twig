{% set breadcrumb_items = this.getNormalizedItems() %}
{% set page_uuid = this.pageUuid %}

{% if breadcrumb_items|length == 0 and page_uuid %}
    {% set sulu_crumbs = sulu_page_breadcrumb(page_uuid) %}
    {% for c in sulu_crumbs %}
        {% set breadcrumb_items = breadcrumb_items|merge([{
            title: c.title|default(''),
            url: c.url|default(null),
        }]) %}
    {% endfor %}
{% endif %}

{% if breadcrumb_items|length > 0 %}
    <div {{ attributes.defaults(this.getRootAttributes(class|default(''))) }}>
        {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
        <div class="{{ this.blockClasses }}">
            <nav aria-label="Breadcrumb">
                <ol class="{{ this.listClasses }}">
                    {% if this.isShowHome() and (breadcrumb_items|first).url != this.getHomeUrl() %}
                        <li class="inline-flex items-center">
                            <a class="flex items-center text-sm text-muted-foreground-1 hover:text-primary focus:outline-hidden focus:text-primary" href="{{ this.getHomeUrl() }}">
                                <svg class="shrink-0 size-4 me-1.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
                                </svg>
                                {{ this.getHomeTitle() }}
                            </a>
                            <svg class="shrink-0 size-3.5 text-muted-foreground mx-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                            </svg>
                        </li>
                    {% endif %}

                    {% for item in breadcrumb_items %}
                        <li class="inline-flex items-center">
                            {% if loop.last %}
                                <span class="inline-flex items-center text-sm font-semibold text-foreground truncate" aria-current="page">
                                    {{ item.title }}
                                </span>
                            {% elseif item.url %}
                                <a class="flex items-center text-sm text-muted-foreground-1 hover:text-primary focus:outline-hidden focus:text-primary" href="{{ item.url }}">
                                    {{ item.title }}
                                </a>
                                <svg class="shrink-0 size-3.5 text-muted-foreground mx-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                </svg>
                            {% else %}
                                <span class="text-sm text-muted-foreground-1">
                                    {{ item.title }}
                                </span>
                                <svg class="shrink-0 size-3.5 text-muted-foreground mx-2" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5" />
                                </svg>
                            {% endif %}
                        </li>
                    {% endfor %}
                </ol>
            </nav>
        </div>
    </div>
{% endif %}
