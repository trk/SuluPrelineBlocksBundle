{# Preline UI 5 / Tailwind CSS 4 Grid Row Component #}
<div {{ attributes.defaults({class: 'w-full my-4', id: this.elementId}) }}>
    <div class="{{ this.rowClasses }}">
        {% if this.hasColumns %}
            {% for col in this.normalizedColumns %}
                <twig:Column
                    :blocks="col.blocks|default([])"
                    :props="col"
                />
            {% endfor %}
        {% endif %}

        {% block content %}{% endblock %}
    </div>
</div>
