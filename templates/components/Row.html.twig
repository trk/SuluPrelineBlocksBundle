{# Preline UI 5 / Tailwind CSS 4 Grid Row Component #}
<div {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    {% if this.hasColumns %}
        {% for col in this.normalizedColumns %}
            <twig:Column
                :blocks="col.blocks|default([])"
                :props="col"
                :context="this.childContext"
            />
        {% endfor %}
    {% endif %}

    {% block content %}{% endblock %}
</div>
