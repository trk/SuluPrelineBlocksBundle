{% set items = this.normalizedItems %}
{% set img_url = this.imageUrl %}
<div {{ attributes.defaults({ class: 'relative w-full my-6' }) }}>
    {% if this.title %}
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">{{ this.title }}</h3>
    {% endif %}

    {% if img_url %}
        <div class="relative w-full rounded-2xl overflow-hidden shadow-md border border-gray-100 dark:border-neutral-800">
            <img
                class="w-full h-auto object-cover"
                src="{{ img_url }}"
                {% if this.imageSrcSet %}srcset="{{ this.imageSrcSet }}" sizes="{{ this.imageSizes }}"{% endif %}
                alt="{{ this.title|default('Image with hotspots') }}"
                {% if this.imageFocusPointStyle %}style="{{ this.imageFocusPointStyle }}"{% endif %}
                loading="lazy"
            >

            {% for item in items %}
                <div class="absolute z-20" style="left: {{ item.x }}%; top: {{ item.y }}%; transform: translate(-50%, -50%);">
                    <div class="hs-tooltip inline-block [--trigger:hover] sm:[--placement:top]">
                        <button type="button"
                                class="hs-tooltip-toggle {{ this.hotspotClasses }}"
                                aria-label="{{ item.title|default('Hotspot details') }}">
                            <svg class="size-3.5 fill-none stroke-current" stroke-width="2.5" viewBox="0 0 24 24">
                                <path d="M12 5v14M5 12h14"/>
                            </svg>
                        </button>

                        <div class="hs-tooltip-content hs-tooltip-shown:opacity-100 hs-tooltip-shown:visible hidden opacity-0 transition-opacity absolute z-30 w-64 p-3 bg-white dark:bg-neutral-800 rounded-xl shadow-xl text-start border border-gray-100 dark:border-neutral-700" role="tooltip">
                            {% if item.badge %}
                                <span class="inline-block py-0.5 px-2 mb-1.5 rounded-full text-[10px] font-semibold bg-primary-100 text-primary-800 dark:bg-primary-900/40 dark:text-primary-400">
                                    {{ item.badge }}
                                </span>
                            {% endif %}

                            {% if item.title %}
                                <h4 class="font-bold text-sm text-gray-900 dark:text-white mb-1">{{ item.title }}</h4>
                            {% endif %}

                            {% if item.content %}
                                <p class="text-xs text-gray-600 dark:text-neutral-300 leading-relaxed mb-2">{{ item.content }}</p>
                            {% endif %}

                            {% if item.link %}
                                <a class="inline-flex items-center gap-x-1 text-xs font-semibold text-primary-600 hover:text-primary-700 dark:text-primary-400 hover:underline" href="{{ item.link }}">
                                    {{ item.link_title }}
                                    <svg class="size-3 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                                </a>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% endif %}
</div>
