{% macro render_badges(badges) %}
    {% for b in badges %}
        {% if b.is_clickable %}
            <a href="{{ b.url }}" {% if b.link_title %}title="{{ b.link_title }}"{% endif %} class="{{ b.classes }} hover:opacity-80 transition-opacity">
                {% if b.has_dot %}<span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>{% endif %}
                {% if b.icon and b.icon_align == 'left' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
                {% if b.title %}<span>{{ b.title }}</span>{% endif %}
                {% if b.icon and b.icon_align == 'right' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
            </a>
        {% else %}
            <span class="{{ b.classes }}">
                {% if b.has_dot %}<span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>{% endif %}
                {% if b.icon and b.icon_align == 'left' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
                {% if b.title %}<span>{{ b.title }}</span>{% endif %}
                {% if b.icon and b.icon_align == 'right' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
            </span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% set is_img = this.isImage() %}
{% set is_vid = this.isVideo() %}
{% set active_img = this.getActiveImageUrl() %}
{% set active_hover_img = this.getActiveHoverImageUrl() %}
{% set active_vid = this.getActiveVideoUrl() %}
{% set active_hover_vid = this.getActiveHoverVideoUrl() %}
{% set link_url = this.getLinkUrl() %}
{% set icon_class = icon is defined and icon ? (icon starts with 'ti ' ? icon : 'ti ti-' ~ icon) : null %}

{% set overlay_pos_classes = this.getOverlayPositionClasses() %}
{% set overlay_style_classes = this.getOverlayStyle() %}
{% set overlay_trans_classes = this.getOverlayTransitionClasses() %}
{% set img_trans_classes = this.getImageTransitionClasses() %}
{% set padding_classes = this.getOverlayPaddingClasses() %}
{% set text_align = this.getTextAlign() %}
{% set meta_align = this.getMetaAlign() %}
{% set title_el = this.getTitleElement() %}
{% set title_size = this.getTitleSizeClasses() %}
{% set title_color = this.getTitleColor() %}
{% set meta_badge_classes = this.getMetaBadgeClasses() %}
{% set is_clickable = this.isEntireOverlayClickable() %}
{% set object_fit_class = this.getObjectFitClass() %}
{% set img_focus_style = this.getImageFocusPointStyle() %}
{% set hover_img_focus_style = this.getHoverImageFocusPointStyle() %}
{% set img_srcset = this.getImageSrcSet() %}
{% set hover_img_srcset = this.getHoverImageSrcSet() %}
{% set img_sizes = this.getImageSizes() %}
{% set wrapper_styles = this.getWrapperStyles() %}

<div {% if this.getElementId() %}id="{{ this.getElementId() }}"{% endif %}
     {% if wrapper_styles %}style="{{ wrapper_styles }}"{% endif %}
     {{ attributes.defaults({
         class: this.getWrapperClasses(),
     }) }}>

    {# 1. Media Layer (Background Image / Video) #}
    <div class="absolute inset-0 z-0 overflow-hidden bg-gray-950">
        {% if is_img and active_img %}
            <img
                src="{{ active_img }}"
                {% if img_srcset %}srcset="{{ img_srcset }}" sizes="{{ img_sizes }}"{% endif %}
                alt="{{ title|default('') }}"
                class="w-full h-full {{ object_fit_class }} {{ img_trans_classes }} {% if active_hover_img %}group-hover:opacity-0{% endif %}"
                {% if img_focus_style %}style="{{ img_focus_style }}"{% endif %}
                loading="lazy"
            />
            {% if active_hover_img %}
                <img
                    src="{{ active_hover_img }}"
                    {% if hover_img_srcset %}srcset="{{ hover_img_srcset }}" sizes="{{ img_sizes }}"{% endif %}
                    alt="{{ title|default('') }}"
                    class="absolute inset-0 w-full h-full {{ object_fit_class }} opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105"
                    {% if hover_img_focus_style %}style="{{ hover_img_focus_style }}"{% endif %}
                    loading="lazy"
                />
            {% endif %}
        {% elseif is_vid and active_vid %}
            <video
                src="{{ active_vid }}"
                class="w-full h-full {{ object_fit_class }} {{ img_trans_classes }} {% if active_hover_vid %}group-hover:opacity-0{% endif %}"
                autoplay
                muted
                playsinline
                loop
            ></video>
            {% if active_hover_vid %}
                <video
                    src="{{ active_hover_vid }}"
                    class="absolute inset-0 w-full h-full {{ object_fit_class }} opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105"
                    autoplay
                    muted
                    playsinline
                    loop
                ></video>
            {% endif %}
        {% else %}
            {# Fallback gradient canvas if no media selected #}
            <div class="w-full h-full bg-linear-to-br from-gray-900 via-neutral-900 to-gray-950"></div>
        {% endif %}
    </div>

    {# 2. Floating Badges (Corner Positioned) #}
    {% if this.hasBadges() and this.getBadgePosition() != 'inline' %}
        <div class="{{ this.getBadgePositionClasses() }}">
            {{ _self.render_badges(this.getNormalizedBadges()) }}
        </div>
    {% endif %}

    {# 3. Overlay Layer & Content Container #}
    <div class="absolute inset-0 z-10 flex flex-col {{ overlay_pos_classes }} {{ overlay_style_classes }} {{ overlay_trans_classes }} {{ padding_classes }} {{ text_align }}">
        <div class="max-w-xl flex flex-col">
            {# Inline Badges #}
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="mb-3 flex flex-wrap gap-1.5">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}

            {# Icon #}
            {% if icon_class %}
                <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white/20 backdrop-blur-sm text-white {% if text_align == 'text-center' %}mx-auto{% elseif text_align == 'text-right' %}ms-auto{% endif %}">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {# Meta Above Title #}
            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {# Heading #}
            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} leading-snug font-bold">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {# Meta Below Title #}
            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {# Description / Content #}
            {% if content %}
                <div class="text-gray-200 text-sm sm:text-base leading-relaxed mt-2 line-clamp-4">
                    {{ content|raw }}
                </div>
            {% endif %}

            {# Meta Below Content #}
            {% if meta and meta_align == 'below-content' %}
                <div class="mt-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {# Actions / Buttons #}
            {% if this.hasButtons() %}
                <div class="relative z-20 mt-5 flex flex-wrap items-center gap-2.5 {% if text_align == 'text-center' %}justify-center{% elseif text_align == 'text-right' %}justify-end{% endif %}">
                    {% for btn in this.getNormalizedButtons() %}
                        <a href="{{ btn.url }}"
                           {% if btn.link_title %}title="{{ btn.link_title }}"{% endif %}
                           class="{{ btn.classes }}"
                        >
                            {% if btn.icon and btn.icon_align == 'left' %}
                                <i class="{{ btn.icon }} shrink-0" aria-hidden="true"></i>
                            {% endif %}
                            {% if btn.title %}
                                <span>{{ btn.title }}</span>
                            {% endif %}
                            {% if btn.icon and btn.icon_align == 'right' %}
                                <i class="{{ btn.icon }} shrink-0" aria-hidden="true"></i>
                            {% endif %}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
    </div>

    {# 4. Stretched Link (Clickable Entire Overlay) #}
    {% if is_clickable and link_url %}
        <a href="{{ link_url }}" class="absolute inset-0 z-20 focus:outline-hidden" aria-label="{{ title|default('Overlay link') }}"></a>
    {% endif %}
</div>
