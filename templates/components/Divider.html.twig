{% set style = this.getDividerStyle() %}
{% set color = this.getDividerColorClasses() %}
{% set thickness = this.getDividerThicknessClasses() %}
{% set width = this.getDividerWidthClasses() %}
{% set align = this.getDividerAlignClasses() %}
{% set icon_class = this.getResolvedIcon() %}

<div {% if this.getElementId() %}id="{{ this.getElementId() }}"{% endif %}
     {{ attributes.defaults({
         class: this.getWrapperClasses(),
     }) }}>

    {% if style == 'icon' and icon_class %}
        <div class="w-full flex items-center text-xs before:flex-1 before:border-t before:border-gray-200 before:me-4 after:flex-1 after:border-t after:border-gray-200 after:ms-4 dark:before:border-neutral-700 dark:after:border-neutral-700">
            <span class="inline-flex items-center justify-center w-8 h-8 rounded-full border border-gray-200 bg-white shadow-2xs text-gray-600 dark:bg-neutral-800 dark:border-neutral-700 dark:text-neutral-300">
                <i class="{{ icon_class }} text-base" aria-hidden="true"></i>
            </span>
        </div>
    {% elseif style == 'small' %}
        <div class="{{ width }} {{ thickness }} {{ color }} rounded-full" role="separator"></div>
    {% elseif style == 'dashed' %}
        <hr class="{{ width }} border-0 border-t border-dashed {{ thickness }} {{ color }}" role="separator" />
    {% elseif style == 'dotted' %}
        <hr class="{{ width }} border-0 border-t border-dotted {{ thickness }} {{ color }}" role="separator" />
    {% else %}
        <hr class="{{ width }} border-0 border-t {{ thickness }} {{ color }}" role="separator" />
    {% endif %}
</div>
