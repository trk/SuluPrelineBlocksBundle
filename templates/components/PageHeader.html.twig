{% set header_layout = this.getLayout() %}
{% set img_url = this.getImageUrl() %}
{% set hover_img_url = this.getHoverImageUrl() %}
{% set vid_url = this.getVideoUrl() %}
{% set hover_vid_url = this.getHoverVideoUrl() %}
{% set icon_class = this.getIconClass() %}
{% set meta_text = this.getMeta() %}
{% set heading_text = this.getHeading() %}
{% set summary_text = this.getSummary() %}
{% set body_content = this.getContent() %}
{% set title_text = heading_text %}

<header class="relative w-full border-b border-gray-200/80 dark:border-neutral-800 bg-white/50 dark:bg-neutral-900/50 backdrop-blur-xs">
    <twig:Section max_width="{{ this.getMaxWidth() }}" padding_y="{{ this.getPaddingY() }}">
        {% if header_layout == 'split' %}
            {# Split Layout: 2 Columns #}
            <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-center">
                <div class="lg:col-span-7 space-y-4">
                    {% if this.isShowBreadcrumbs() %}
                        <twig:Breadcrumbs class="mb-2" />
                    {% endif %}

                    {% if meta_text %}
                        <div>
                            <span class="inline-flex items-center gap-x-1.5 py-1 px-3 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">
                                {{ meta_text }}
                            </span>
                        </div>
                    {% endif %}

                    {% if heading_text %}
                        <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 dark:text-white">
                            {{ heading_text }}
                        </h1>
                    {% endif %}

                    {% if summary_text %}
                        <p class="text-lg sm:text-xl text-gray-600 dark:text-neutral-300 font-normal leading-relaxed">
                            {{ summary_text }}
                        </p>
                    {% endif %}

                    {% if body_content %}
                        <div class="text-base sm:text-lg text-gray-600 dark:text-neutral-300 prose dark:prose-invert max-w-none leading-relaxed">
                            {{ body_content|raw }}
                        </div>
                    {% endif %}
                </div>

                <div class="lg:col-span-5">
                    {% if vid_url %}
                        <div class="relative rounded-2xl overflow-hidden shadow-xl border border-gray-200 dark:border-neutral-800 aspect-video bg-black">
                            <video src="{{ vid_url }}" controls class="w-full h-full object-cover">
                                Your browser does not support the video tag.
                            </video>
                        </div>
                    {% elseif img_url %}
                        <div class="group relative rounded-2xl overflow-hidden shadow-xl border border-gray-200 dark:border-neutral-800 aspect-4/3 sm:aspect-16/10 bg-gray-100 dark:bg-neutral-800">
                            <img src="{{ img_url }}" alt="{{ heading_text }}" loading="eager" fetchpriority="high" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 {{ hover_img_url ? 'group-hover:opacity-0' : '' }}">
                            {% if hover_img_url %}
                                <img src="{{ hover_img_url }}" alt="{{ heading_text }}" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                            {% endif %}
                        </div>
                    {% elseif icon_class %}
                        <div class="flex items-center justify-center size-24 sm:size-32 rounded-3xl bg-blue-50 text-blue-600 dark:bg-neutral-800 dark:text-blue-400 mx-auto shadow-inner">
                            <i class="{{ icon_class }} text-5xl sm:text-6xl" aria-hidden="true"></i>
                        </div>
                    {% endif %}
                </div>
            </div>

        {% elseif header_layout == 'minimal' %}
            {# Minimal Layout: Compact Title & Meta Only #}
            <div class="space-y-3">
                {% if this.isShowBreadcrumbs() %}
                    <twig:Breadcrumbs class="mb-2" />
                {% endif %}

                <div class="flex flex-wrap items-center gap-3">
                    {% if meta_text %}
                        <span class="inline-flex items-center gap-x-1.5 py-0.5 px-2.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 dark:bg-neutral-800 dark:text-neutral-200">
                            {{ meta_text }}
                        </span>
                    {% endif %}

                    {% if heading_text %}
                        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight text-gray-900 dark:text-white">
                            {{ heading_text }}
                        </h1>
                    {% endif %}
                </div>

                {% if summary_text %}
                    <p class="text-base sm:text-lg text-gray-600 dark:text-neutral-300 font-normal leading-relaxed">
                        {{ summary_text }}
                    </p>
                {% endif %}

                {% if body_content %}
                    <div class="text-sm sm:text-base text-gray-600 dark:text-neutral-400 max-w-3xl prose dark:prose-invert">
                        {{ body_content|raw }}
                    </div>
                {% endif %}
            </div>

        {% else %}
            {# Standard Stacked Layout #}
            <div class="max-w-4xl space-y-4">
                {% if this.isShowBreadcrumbs() %}
                    <twig:Breadcrumbs class="mb-2" />
                {% endif %}

                {% if meta_text %}
                    <div>
                        <span class="inline-flex items-center gap-x-1.5 py-1 px-3 rounded-full text-xs font-semibold bg-blue-100 text-blue-800 dark:bg-blue-900/40 dark:text-blue-300">
                            {{ meta_text }}
                        </span>
                    </div>
                {% endif %}

                {% if heading_text %}
                    <h1 class="text-3xl sm:text-4xl lg:text-5xl font-black tracking-tight text-gray-900 dark:text-white">
                        {{ heading_text }}
                    </h1>
                {% endif %}

                {% if summary_text %}
                    <p class="text-lg sm:text-xl text-gray-600 dark:text-neutral-300 font-normal leading-relaxed">
                        {{ summary_text }}
                    </p>
                {% endif %}

                {% if body_content %}
                    <div class="text-base sm:text-lg text-gray-600 dark:text-neutral-300 prose dark:prose-invert max-w-none leading-relaxed">
                        {{ body_content|raw }}
                    </div>
                {% endif %}
            </div>

            {% if vid_url %}
                <div class="mt-8 rounded-2xl overflow-hidden shadow-xl border border-gray-200 dark:border-neutral-800 aspect-video bg-black max-w-5xl">
                    <video src="{{ vid_url }}" controls class="w-full h-full object-cover">
                        Your browser does not support the video tag.
                    </video>
                </div>
            {% elseif img_url %}
                <div class="group relative mt-8 rounded-2xl overflow-hidden shadow-xl border border-gray-200 dark:border-neutral-800 aspect-16/9 sm:aspect-21/9 bg-gray-100 dark:bg-neutral-800 max-w-5xl">
                    <img src="{{ img_url }}" alt="{{ heading_text }}" loading="eager" fetchpriority="high" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105 {{ hover_img_url ? 'group-hover:opacity-0' : '' }}">
                    {% if hover_img_url %}
                        <img src="{{ hover_img_url }}" alt="{{ heading_text }}" class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:opacity-100">
                    {% endif %}
                </div>
            {% elseif icon_class %}
                <div class="mt-6 inline-flex items-center justify-center size-16 sm:size-20 rounded-2xl bg-blue-50 text-blue-600 dark:bg-neutral-800 dark:text-blue-400 shadow-inner">
                    <i class="{{ icon_class }} text-3xl sm:text-4xl" aria-hidden="true"></i>
                </div>
            {% endif %}
        {% endif %}
    </twig:Section>
</header>
