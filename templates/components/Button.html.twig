{% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
{% if this.isGroup() %}
    <div {{ attributes.defaults(this.getRootAttributes()) }}>
        {% for item in this.getNormalizedItems() %}
            <twig:Button :block="item" />
        {% endfor %}
    </div>
{% else %}
    {% set target = this.getLinkTarget() %}
    <a href="{{ this.getUrl() }}"
       {% if target %}target="{{ target }}"{% if target == '_blank' %} rel="noopener noreferrer"{% endif %}{% endif %}
       {% if this.getLinkTitle() %}title="{{ this.getLinkTitle() }}"{% endif %}
       {{ attributes.defaults(this.getRootAttributes()) }}
    >
        {% if this.getResolvedIcon() and this.getIconAlign() == 'left' %}
            <i class="{{ this.getResolvedIcon() }} shrink-0" aria-hidden="true"></i>
        {% endif %}
        {% if this.getTitle() %}
            <span>{{ this.getTitle() }}</span>
        {% endif %}
        {% if this.getResolvedIcon() and this.getIconAlign() == 'right' %}
            <i class="{{ this.getResolvedIcon() }} shrink-0" aria-hidden="true"></i>
        {% endif %}
    </a>
{% endif %}
