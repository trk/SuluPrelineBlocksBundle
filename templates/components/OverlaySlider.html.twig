{% set normalized_items = this.normalizedItems %}
{% set arrows = this.arrows %}
{% set dots = this.dots %}
{% set slide_width = this.slideWidthClass %}
{% set gap_class = this.gapClass %}

<section
    {% if this.customId %}id="{{ this.customId }}"{% endif %}
    class="w-full {{ this.marginClass }} {{ this.customClass }}"
>
    {% if title %}
        <div class="flex items-center justify-between mb-6">
            <h3 class="text-2xl font-bold tracking-tight text-foreground">
                {{ title }}
            </h3>
        </div>
    {% endif %}

    <div
        data-hs-carousel='{{ this.carouselConfigJson|raw }}'
        class="relative w-full"
    >
        <div class="hs-carousel relative overflow-hidden w-full min-h-[380px] rounded-xl">
            <div class="hs-carousel-body absolute top-0 bottom-0 start-0 flex flex-nowrap transition-transform duration-700 opacity-0 -mx-2.5">
                {% for item in normalized_items %}
                    <div class="hs-carousel-slide shrink-0 {{ slide_width }} {{ gap_class }} h-full">
                        <twig:Overlay
                            :block="item"
                            :link="item.link|default(item.url|default(null))"
                        />
                    </div>
                {% endfor %}
            </div>
        </div>

        {% if arrows != 'none' %}
            <button
                type="button"
                class="hs-carousel-prev hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 start-0 inline-flex justify-center items-center w-11 h-11 my-auto text-layer-foreground bg-layer/80 backdrop-blur-xs hover:bg-layer rounded-full shadow-md z-10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all {% if arrows == 'outside' %}-start-4{% else %}start-2{% endif %}"
                aria-label="Previous"
            >
                <span class="text-2xl" aria-hidden="true">
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
                </span>
                <span class="sr-only">Previous</span>
            </button>
            <button
                type="button"
                class="hs-carousel-next hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 end-0 inline-flex justify-center items-center w-11 h-11 my-auto text-layer-foreground bg-layer/80 backdrop-blur-xs hover:bg-layer rounded-full shadow-md z-10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all {% if arrows == 'outside' %}-end-4{% else %}end-2{% endif %}"
                aria-label="Next"
            >
                <span class="text-2xl" aria-hidden="true">
                    <svg class="size-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6 6-6"/></svg>
                </span>
                <span class="sr-only">Next</span>
            </button>
        {% endif %}

        {% if dots != 'none' %}
            <div class="hs-carousel-pagination flex justify-center items-center gap-x-2 {% if dots == 'inside' %}absolute bottom-3 start-0 end-0 z-10{% else %}mt-4{% endif %}">
                {% for item in normalized_items %}
                    <span class="hs-carousel-active:bg-primary hs-carousel-active:border-primary size-2.5 border border-line-4 rounded-full cursor-pointer transition-colors"></span>
                {% endfor %}
            </div>
        {% endif %}
    </div>
</section>
