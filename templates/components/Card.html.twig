{% macro render_badges(badges) %}
    {% for b in badges %}
        {% if b.is_clickable %}
            <a href="{{ b.url }}" {% if b.link_title %}title="{{ b.link_title }}"{% endif %} class="{{ b.classes }} hover:opacity-80 transition-opacity">
                {% if b.has_dot %}<span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>{% endif %}
                {% if b.icon and b.icon_align == 'left' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
                {% if b.title %}<span>{{ b.title }}</span>{% endif %}
                {% if b.icon and b.icon_align == 'right' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
            </a>
        {% else %}
            <span class="{{ b.classes }}">
                {% if b.has_dot %}<span class="size-1.5 inline-block rounded-full bg-current shrink-0" aria-hidden="true"></span>{% endif %}
                {% if b.icon and b.icon_align == 'left' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
                {% if b.title %}<span>{{ b.title }}</span>{% endif %}
                {% if b.icon and b.icon_align == 'right' %}<i class="{{ b.icon }} shrink-0" aria-hidden="true"></i>{% endif %}
            </span>
        {% endif %}
    {% endfor %}
{% endmacro %}

{% set title_color = this.getTitleColor() %}
{% set is_img = this.isImage() %}
{% set is_vid = this.isVideo() %}
{% set active_img = this.getActiveImageUrl() %}
{% set active_hover_img = this.getActiveHoverImageUrl() %}
{% set active_vid = this.getActiveVideoUrl() %}
{% set active_hover_vid = this.getActiveHoverVideoUrl() %}
{% set icon_class = this.iconClass %}
{% set has_media = this.hasMedia() %}

{% set media_align = this.getMediaAlign() %}
{% set media_aspect = this.getMediaAspectRatioClass() %}
{% set media_aspect_style = this.getMediaAspectRatioStyle() %}
{% set object_fit_class = this.getObjectFitClass() %}
{% set img_focus_style = this.getImageFocusPointStyle() %}
{% set hover_img_focus_style = this.getHoverImageFocusPointStyle() %}
{% set img_srcset = this.getImageSrcSet() %}
{% set hover_img_srcset = this.getHoverImageSrcSet() %}
{% set img_sizes = this.getImageSizes() %}
{% set media_col_width = this.getMediaGridWidthClasses() %}
{% set content_col_width = this.getContentGridWidthClasses() %}
{% set meta_align = this.getMetaAlign() %}
{% set title_el = this.getTitleElement() %}
{% set title_size = this.getTitleSizeClasses() %}
{% set title_decoration = this.getTitleDecorationClasses() %}
{% set meta_badge_classes = this.getMetaBadgeClasses() %}
{% set padding_classes = this.getCardPaddingClasses() %}
{% set card_url = this.getResolvedCardUrl() %}

{# Shared Media Markup Block #}
{% set media_markup %}
    {% if is_img and active_img %}
        <div class="relative w-full h-full overflow-hidden bg-gray-100 dark:bg-neutral-800">
            {% if this.hasBadges() and this.getBadgePosition() != 'inline' %}
                <div class="{{ this.getBadgePositionClasses() }}">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}
            <img
                src="{{ active_img }}"
                {% if img_srcset %}srcset="{{ img_srcset }}" sizes="{{ img_sizes }}"{% endif %}
                alt="{{ title|default('') }}"
                class="w-full h-full {{ object_fit_class }} transition-transform duration-500 ease-out group-hover:scale-105 {% if active_hover_img %}group-hover:opacity-0{% endif %}"
                {% if img_focus_style %}style="{{ img_focus_style }}"{% endif %}
                loading="lazy"
            />
            {% if active_hover_img %}
                <img
                    src="{{ active_hover_img }}"
                    {% if hover_img_srcset %}srcset="{{ hover_img_srcset }}" sizes="{{ img_sizes }}"{% endif %}
                    alt="{{ title|default('') }}"
                    class="absolute inset-0 w-full h-full {{ object_fit_class }} opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105"
                    {% if hover_img_focus_style %}style="{{ hover_img_focus_style }}"{% endif %}
                    loading="lazy"
                />
            {% endif %}
        </div>
    {% elseif is_vid and active_vid %}
        <div class="relative w-full h-full overflow-hidden bg-gray-100 dark:bg-neutral-800">
            {% if this.hasBadges() and this.getBadgePosition() != 'inline' %}
                <div class="{{ this.getBadgePositionClasses() }}">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}
            <video
                src="{{ active_vid }}"
                class="w-full h-full {{ object_fit_class }} transition-transform duration-500 ease-out group-hover:scale-105 {% if active_hover_vid %}group-hover:opacity-0{% endif %}"
                autoplay
                muted
                playsinline
                loop
            ></video>
            {% if active_hover_vid %}
                <video
                    src="{{ active_hover_vid }}"
                    class="absolute inset-0 w-full h-full {{ object_fit_class }} opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105"
                    autoplay
                    muted
                    playsinline
                    loop
                ></video>
            {% endif %}
        </div>
    {% endif %}
{% endset %}

{# Shared Actions Markup Block #}
{% set actions_markup %}
    {% if this.hasButtons() %}
        <div class="relative z-20 mt-4 flex flex-wrap items-center gap-2.5">
            {% for btn in this.getNormalizedButtons() %}
                <a href="{{ btn.url }}"
                   {% if btn.link_title %}title="{{ btn.link_title }}"{% endif %}
                   class="{{ btn.classes }}"
                >
                    {% if btn.icon and btn.icon_align == 'left' %}
                        <i class="{{ btn.icon }} shrink-0" aria-hidden="true"></i>
                    {% endif %}
                    {% if btn.title %}
                        <span>{{ btn.title }}</span>
                    {% endif %}
                    {% if btn.icon and btn.icon_align == 'right' %}
                        <i class="{{ btn.icon }} shrink-0" aria-hidden="true"></i>
                    {% endif %}
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endset %}

<div {% if this.getElementId() %}id="{{ this.getElementId() }}"{% endif %}
     {{ attributes.defaults({
         class: this.getWrapperClasses(),
     }) }}>

    {# 1. Overlay Mode (Full Background Media with Gradient) #}
    {% if media_align == 'overlay' and has_media %}
        <div class="absolute inset-0 z-0">
            {{ media_markup|raw }}
            <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/40 to-transparent"></div>
        </div>
        <div class="relative z-10 flex flex-col justify-end min-h-[320px] p-6 text-white flex-1">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="mb-3 flex flex-wrap gap-1.5">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-white/20 backdrop-blur-sm text-white">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} text-white {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-gray-200 text-sm leading-relaxed mt-2 line-clamp-3">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mt-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

    {# 2. Horizontal Mode (Left or Right Media with responsive columns) #}
    {% elseif media_align in ['left', 'right'] and has_media %}
        <div class="{{ media_col_width }} shrink-0 relative overflow-hidden min-h-[220px] md:min-h-full {{ media_aspect }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>
        <div class="{{ content_col_width }} flex flex-col flex-1 justify-between {{ padding_classes }}">
            <div>
                {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                    <div class="mb-3 flex flex-wrap gap-1.5">
                        {{ _self.render_badges(this.getNormalizedBadges()) }}
                    </div>
                {% endif %}

                {% if icon_class %}
                    <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 dark:bg-primary-950/40 dark:text-primary-400">
                        <i class="{{ icon_class }}" aria-hidden="true"></i>
                    </div>
                {% endif %}

                {% if meta and meta_align == 'above-title' %}
                    <div class="mb-2">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}

                {% if title %}
                    <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                        {{ title }}
                    </{{ title_el }}>
                {% endif %}

                {% if meta and meta_align == 'below-title' %}
                    <div class="mt-2 mb-2">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}

                {% if content %}
                    <div class="text-gray-600 dark:text-neutral-400 text-sm leading-relaxed mt-2">
                        {{ content|raw }}
                    </div>
                {% endif %}

                {% if meta and meta_align == 'below-content' %}
                    <div class="mt-3">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}
            </div>

            {{ actions_markup|raw }}
        </div>

    {# 3. Between Mode (Header -> Media in middle -> Content & Actions) #}
    {% elseif media_align == 'between' and has_media %}
        <div class="{{ padding_classes }} pb-3">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="mb-3 flex flex-wrap gap-1.5">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 dark:bg-primary-950/40 dark:text-primary-400">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}
        </div>

        <div class="relative w-full overflow-hidden {{ media_aspect }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>

        <div class="{{ padding_classes }} pt-3 flex flex-col flex-1">
            {% if content %}
                <div class="text-gray-600 dark:text-neutral-400 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

    {# 4. Bottom Mode (Content on top -> Media at bottom) #}
    {% elseif media_align == 'bottom' and has_media %}
        <div class="{{ padding_classes }} flex flex-col flex-1">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="mb-3 flex flex-wrap gap-1.5">
                    {{ _self.render_badges(this.getNormalizedBadges()) }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 dark:bg-primary-950/40 dark:text-primary-400">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-gray-600 dark:text-neutral-400 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

        <div class="relative w-full overflow-hidden {{ media_aspect }} mt-auto" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>

    {# 5. Standard Vertical Mode (Media on top -> Content) #}
    {% else %}
        {% if has_media %}
            <div class="relative w-full overflow-hidden {{ media_aspect }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
                {{ media_markup|raw }}
            </div>
        {% endif %}

        <div class="{{ padding_classes }} flex flex-col flex-1">
            {% if this.hasBadges() and (not has_media or this.getBadgePosition() == 'inline') %}
                {% if not has_media and this.getBadgePosition() in ['top-right', 'top_right'] %}
                    <div class="absolute top-4 end-4 z-10 flex flex-wrap gap-1.5">
                        {{ _self.render_badges(this.getNormalizedBadges()) }}
                    </div>
                {% else %}
                    <div class="mb-3 flex flex-wrap gap-1.5">
                        {{ _self.render_badges(this.getNormalizedBadges()) }}
                    </div>
                {% endif %}
            {% endif %}

            {% if icon_class and not has_media %}
                <div class="mb-3 inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary-50 text-primary-600 dark:bg-primary-950/40 dark:text-primary-400">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-gray-600 dark:text-neutral-400 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>
    {% endif %}

    {# Stretched Link for Clickable Card #}
    {% if card_url %}
        <a href="{{ card_url }}" class="absolute inset-0 z-10 focus:outline-hidden" aria-label="{{ title|default('Card link') }}"></a>
    {% endif %}
</div>
