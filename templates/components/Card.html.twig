{% set title = this.title %}
{% set meta = this.meta %}
{% set content = this.resolvedContent %}
{% set title_color = this.getTitleColor() %}
{% set is_img = this.isImage() %}
{% set is_vid = this.isVideo() %}
{% set active_img = this.getActiveImageUrl() %}
{% set active_hover_img = this.getActiveHoverImageUrl() %}
{% set active_vid = this.getActiveVideoUrl() %}
{% set active_hover_vid = this.getActiveHoverVideoUrl() %}
{% set icon_class = this.iconClass %}
{% set has_media = this.hasMedia() %}

{% set media_align = this.getMediaAlign() %}
{% set media_aspect = this.getMediaAspectRatioClass() %}
{% set media_aspect_style = this.getMediaAspectRatioStyle() %}
{% set object_fit_class = this.getObjectFitClass() %}
{% set img_focus_style = this.getImageFocusPointStyle() %}
{% set hover_img_focus_style = this.getHoverImageFocusPointStyle() %}
{% set img_srcset = this.getImageSrcSet() %}
{% set hover_img_srcset = this.getHoverImageSrcSet() %}
{% set img_sizes = this.getImageSizes() %}
{% set content_col_width = this.getContentGridWidthClasses() %}
{% set meta_align = this.getMetaAlign() %}
{% set title_el = this.getTitleElement() %}
{% set title_size = this.getTitleSizeClasses() %}
{% set title_decoration = this.getTitleDecorationClasses() %}
{% set meta_badge_classes = this.getMetaBadgeClasses() %}
{% set padding_classes = this.getCardPaddingClasses() %}
{% set card_url = this.getResolvedCardUrl() %}

{% set badges_markup %}
    {% for b in this.getNormalizedBadges() %}
        <twig:Badge :block="b" />
    {% endfor %}
{% endset %}

{# Shared Media Markup Block #}
{% set media_markup %}
    {% if is_img and active_img %}
        <div class="relative w-full h-full overflow-hidden bg-surface">
            {% if this.hasBadges() and this.getBadgePosition() != 'inline' %}
                <div class="{{ this.getBadgePositionClasses('z-20') }}">
                    {{ badges_markup|raw }}
                </div>
            {% endif %}
            <twig:Image
                :bare="true"
                :image_url="active_img"
                :image_srcset="img_srcset"
                :sizes="img_sizes"
                :dimensions="this.getIntrinsicImageDimensions('16/9')"
                :image_focus_style="img_focus_style"
                :hover_image_url="active_hover_img"
                :hover_image_srcset="hover_img_srcset"
                :hover_image_focus_style="hover_img_focus_style"
                :alt="this.getImageAlt()"
                :loading="this.getImageLoading()"
                :fetchpriority="this.getImageFetchPriority()"
                :img_class="'w-full h-full ' ~ object_fit_class ~ ' transition-transform duration-500 ease-out group-hover:scale-105' ~ (active_hover_img ? ' group-hover:opacity-0' : '')"
                :hover_img_class="'absolute inset-0 w-full h-full ' ~ object_fit_class ~ ' opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105'"
            />
        </div>
    {% elseif is_vid and active_vid %}
        <div class="relative w-full h-full overflow-hidden bg-surface">
            {% if this.hasBadges() and this.getBadgePosition() != 'inline' %}
                <div class="{{ this.getBadgePositionClasses('z-20') }}">
                    {{ badges_markup|raw }}
                </div>
            {% endif %}
            <twig:Video
                :bare="true"
                :video_url="active_vid"
                :hover_video_url="active_hover_vid"
                :controls="false"
                :autoplay="true"
                :muted="true"
                :loop="true"
                :video_class="'w-full h-full ' ~ object_fit_class ~ ' transition-transform duration-500 ease-out group-hover:scale-105' ~ (active_hover_vid ? ' group-hover:opacity-0' : '')"
                :hover_video_class="'absolute inset-0 w-full h-full ' ~ object_fit_class ~ ' opacity-0 group-hover:opacity-100 transition-all duration-500 ease-out group-hover:scale-105'"
            />
        </div>
    {% endif %}
{% endset %}

{# Shared Actions Markup Block #}
{% set actions_markup %}
    {% if this.hasButtons() %}
        <div class="relative z-20 mt-4 flex flex-wrap items-center gap-2.5">
            {% for btn in this.getNormalizedButtons() %}
                <twig:Button :bare="true" :block="btn" />
            {% endfor %}
        </div>
    {% endif %}
{% endset %}

<div {{ attributes.defaults(this.getRootAttributes()) }}>
    {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
    <div class="{{ this.blockClasses }}"{% if media_align == 'overlay' and media_aspect_style %} style="{{ media_aspect_style }}"{% endif %}>

    {# 1. Overlay Mode (Full Background Media with Gradient) #}
    {% if media_align == 'overlay' and has_media %}
        <div class="absolute inset-0">
            {{ media_markup|raw }}
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/40 to-transparent"></div>
        </div>
        <div class="{{ this.getOverlayContentClasses() }}">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="relative z-20 mb-3 flex flex-wrap gap-1.5">
                    {{ badges_markup|raw }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="{{ this.getIconTileClasses() }}">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} text-white {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-white/80 text-sm leading-relaxed mt-2 line-clamp-3">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mt-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

    {# 2. Horizontal Mode (Left or Right Media with responsive columns) #}
    {% elseif media_align in ['left', 'right'] and has_media %}
        <div class="{{ this.getMediaColumnClasses() }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>
        <div class="{{ content_col_width }} flex flex-col flex-1 justify-between {{ padding_classes }}">
            <div>
                {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                    <div class="relative z-20 mb-3 flex flex-wrap gap-1.5">
                        {{ badges_markup|raw }}
                    </div>
                {% endif %}

                {% if icon_class %}
                    <div class="{{ this.getIconTileClasses() }}">
                        <i class="{{ icon_class }}" aria-hidden="true"></i>
                    </div>
                {% endif %}

                {% if meta and meta_align == 'above-title' %}
                    <div class="mb-2">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}

                {% if title %}
                    <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                        {{ title }}
                    </{{ title_el }}>
                {% endif %}

                {% if meta and meta_align == 'below-title' %}
                    <div class="mt-2 mb-2">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}

                {% if content %}
                    <div class="text-muted-foreground-2 text-sm leading-relaxed mt-2">
                        {{ content|raw }}
                    </div>
                {% endif %}

                {% if meta and meta_align == 'below-content' %}
                    <div class="mt-3">
                        <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                    </div>
                {% endif %}
            </div>

            {{ actions_markup|raw }}
        </div>

    {# 3. Between Mode (Header -> Media in middle -> Content & Actions) #}
    {% elseif media_align == 'between' and has_media %}
        <div class="{{ padding_classes }} pb-3">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="relative z-20 mb-3 flex flex-wrap gap-1.5">
                    {{ badges_markup|raw }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="{{ this.getIconTileClasses() }}">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}
        </div>

        <div class="relative w-full overflow-hidden {{ media_aspect }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>

        <div class="{{ padding_classes }} pt-3 flex flex-col flex-1">
            {% if content %}
                <div class="text-muted-foreground-2 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

    {# 4. Bottom Mode (Content on top -> Media at bottom) #}
    {% elseif media_align == 'bottom' and has_media %}
        <div class="{{ padding_classes }} flex flex-col flex-1">
            {% if this.hasBadges() and this.getBadgePosition() == 'inline' %}
                <div class="relative z-20 mb-3 flex flex-wrap gap-1.5">
                    {{ badges_markup|raw }}
                </div>
            {% endif %}

            {% if icon_class %}
                <div class="{{ this.getIconTileClasses() }}">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-muted-foreground-2 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>

        <div class="relative w-full overflow-hidden {{ media_aspect }} mt-auto" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
            {{ media_markup|raw }}
        </div>

    {# 5. Standard Vertical Mode (Media on top -> Content) #}
    {% else %}
        {% if has_media %}
            <div class="relative w-full overflow-hidden {{ media_aspect }}" {% if media_aspect_style %}style="{{ media_aspect_style }}"{% endif %}>
                {{ media_markup|raw }}
            </div>
        {% endif %}

        <div class="{{ padding_classes }} flex flex-col flex-1">
            {% if this.hasBadges() and (not has_media or this.getBadgePosition() == 'inline') %}
                {% if not has_media and this.getBadgePosition() in ['top-right', 'top_right'] %}
                    <div class="absolute top-4 end-4 z-20 flex flex-wrap gap-1.5">
                        {{ badges_markup|raw }}
                    </div>
                {% else %}
                    <div class="relative z-20 mb-3 flex flex-wrap gap-1.5">
                        {{ badges_markup|raw }}
                    </div>
                {% endif %}
            {% endif %}

            {% if icon_class and not has_media %}
                <div class="{{ this.getIconTileClasses() }}">
                    <i class="{{ icon_class }}" aria-hidden="true"></i>
                </div>
            {% endif %}

            {% if meta and meta_align == 'above-title' %}
                <div class="mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if title %}
                <{{ title_el }} class="{{ title_size }} {{ title_color }} {{ title_decoration }} leading-snug">
                    {{ title }}
                </{{ title_el }}>
            {% endif %}

            {% if meta and meta_align == 'below-title' %}
                <div class="mt-2 mb-2">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {% if content %}
                <div class="text-muted-foreground-2 text-sm leading-relaxed mb-4 flex-1">
                    {{ content|raw }}
                </div>
            {% endif %}

            {% if meta and meta_align == 'below-content' %}
                <div class="mb-3">
                    <span class="{{ meta_badge_classes }}">{{ meta }}</span>
                </div>
            {% endif %}

            {{ actions_markup|raw }}
        </div>
    {% endif %}

    {# Stretched Link for Clickable Card #}
    {% if card_url %}
        <a href="{{ card_url }}" class="absolute inset-0 z-10 focus:outline-hidden" aria-label="{{ title|default('Card link') }}"></a>
    {% endif %}
    </div>
</div>
