{# Custom HTML / Embed Snippet Component #}
{% if this.hasContent %}
    {% if this.isRaw %}
        {{ this.content|raw }}
    {% else %}
        <div {{ attributes.defaults({class: this.wrapperClasses}) }}>
            {% if this.title %}
                <div class="mb-3">
                    <h3 class="text-base font-bold text-foreground">
                        {{ this.title }}
                    </h3>
                </div>
            {% endif %}
            {{ this.content|raw }}
        </div>
    {% endif %}
{% endif %}
