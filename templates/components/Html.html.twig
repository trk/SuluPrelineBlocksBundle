{# Custom HTML / Embed Snippet Component #}
{% if this.hasContent %}
    {% if this.isRaw %}
        {{ this.content|raw }}
    {% else %}
        {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
        <div {% if this.elementId %}id="{{ this.elementId }}"{% endif %}
             {{ attributes.defaults(this.customAttributes|merge({class: this.wrapperClasses})) }}>
            {% if this.title %}
                <div class="mb-3">
                    <h3 class="text-base font-bold text-foreground">
                        {{ this.title }}
                    </h3>
                </div>
            {% endif %}
            {{ this.content|raw }}
        </div>
    {% endif %}
{% endif %}
