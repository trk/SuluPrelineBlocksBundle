{# Custom HTML / Embed Snippet Component #}
{% if this.hasContent %}
    {% if this.isRaw %}
        {{ this.content|raw }}
    {% else %}
        <div {{ attributes.defaults(this.getRootAttributes()) }}>
            {% if this.scopedCss %}<style>{{ this.scopedCss|raw }}</style>{% endif %}
            <div class="{{ this.blockClasses }}">
                {% if this.title %}
                    <div class="mb-3">
                        <h3 class="text-base font-bold text-foreground">
                            {{ this.title }}
                        </h3>
                    </div>
                {% endif %}
                {{ this.content|raw }}
            </div>
        </div>
    {% endif %}
{% endif %}
