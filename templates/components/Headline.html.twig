{% set tag = this.getTag()|default('h2') %}
{% set url = this.getUrl() %}
{% set img_url = this.getImageUrl() %}
{% set icon_class = this.iconClass %}

<{{ tag }} {% if this.getElementId() %}id="{{ this.getElementId() }}"{% endif %}
    {{ attributes.defaults({
        class: this.getWrapperClasses(),
    }) }}>
    {% if img_url %}
        <img src="{{ img_url }}" alt="" class="inline-block w-8 h-8 mr-2 align-middle object-contain" />
    {% endif %}
    {% if icon_class %}
        <span class="inline-block mr-2 align-middle"><i class="{{ icon_class }}" aria-hidden="true"></i></span>
    {% endif %}
    {% if url %}
        <a href="{{ url }}" class="hover:underline transition-colors">
            {{ content }}
        </a>
    {% else %}
        {{ content }}
    {% endif %}
</{{ tag }}>
