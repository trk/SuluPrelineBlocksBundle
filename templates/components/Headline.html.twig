{% set tag = this.getTag()|default('h2') %}
{% set url = this.getUrl() %}
{% set img_url = this.getImageUrl() %}
{% set img_focus_style = this.getImageFocusPointStyle() %}
{% set icon_class = this.iconClass %}
{% set headline_title = this.getTitle() %}

<{{ tag }} {% if this.getElementId() %}id="{{ this.getElementId() }}"{% endif %}
    {{ attributes.defaults({
        class: this.getWrapperClasses(),
    }) }}>
    {% if img_url %}
        <img src="{{ img_url }}" alt="{{ this.getImageAlt() }}" class="inline-block w-8 h-8 mr-2 align-middle object-contain" {% if img_focus_style %}style="{{ img_focus_style }}"{% endif %} loading="lazy" />
    {% endif %}
    {% if icon_class %}
        <span class="inline-block mr-2 align-middle"><i class="{{ icon_class }}" aria-hidden="true"></i></span>
    {% endif %}
    {% if url %}
        <a href="{{ url }}" class="hover:underline transition-colors">
            {{ headline_title }}
        </a>
    {% else %}
        {{ headline_title }}
    {% endif %}
</{{ tag }}>
