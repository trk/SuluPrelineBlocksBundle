<div class="mb-8 flex flex-wrap gap-2 {{ filter_align_class|default('justify-center') }}">
    <button
        type="button"
        data-filter="*"
        class="active filter-btn py-2 px-3.5 inline-flex items-center text-sm font-medium rounded-lg border border-transparent bg-primary text-primary-foreground hover:bg-primary-hover focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-50 transition"
    >
        {{ all_label|default('All') }}
    </button>
    {% for slug, label in filter_tags|default({}) %}
        <button
            type="button"
            data-filter="{{ slug }}"
            class="filter-btn py-2 px-3.5 inline-flex items-center text-sm font-medium rounded-lg border border-layer-line bg-layer text-layer-foreground shadow-2xs hover:bg-layer-hover focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary disabled:opacity-50 transition"
        >
            {{ label }}
        </button>
    {% endfor %}
</div>
