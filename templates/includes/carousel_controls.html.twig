{% set arrows = arrows|default('inside') %}
{% set pagination = pagination|default('none') %}
{% set items_count = items_count|default(0) %}
{% set variant = variant|default('default') %}

{% if arrows != 'none' %}
    {% if variant == 'slideshow' %}
        {% set prev_classes = 'hs-carousel-prev hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 start-0 inline-flex justify-center items-center w-12 h-12 my-auto text-white bg-black/40 backdrop-blur-xs hover:bg-black/70 rounded-full shadow-lg z-20 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all ' ~ (arrows == 'outside' ? '-start-5' : 'start-4') %}
        {% set next_classes = 'hs-carousel-next hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 end-0 inline-flex justify-center items-center w-12 h-12 my-auto text-white bg-black/40 backdrop-blur-xs hover:bg-black/70 rounded-full shadow-lg z-20 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all ' ~ (arrows == 'outside' ? '-end-5' : 'end-4') %}
        {% set icon_size = 'size-5' %}
    {% else %}
        {% set prev_classes = 'hs-carousel-prev hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 start-0 inline-flex justify-center items-center w-11 h-11 my-auto text-layer-foreground bg-layer/80 backdrop-blur-xs hover:bg-layer rounded-full shadow-md z-10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all ' ~ (arrows == 'outside' ? '-start-4' : 'start-2') %}
        {% set next_classes = 'hs-carousel-next hs-carousel-disabled:opacity-50 disabled:pointer-events-none absolute inset-y-0 end-0 inline-flex justify-center items-center w-11 h-11 my-auto text-layer-foreground bg-layer/80 backdrop-blur-xs hover:bg-layer rounded-full shadow-md z-10 focus:outline-hidden focus-visible:ring-2 focus-visible:ring-primary transition-all ' ~ (arrows == 'outside' ? '-end-4' : 'end-2') %}
        {% set icon_size = 'size-4' %}
    {% endif %}

    <button
        type="button"
        class="{{ prev_classes }}"
        aria-label="Previous"
    >
        <span class="text-2xl" aria-hidden="true">
            <svg class="{{ icon_size }}" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m15 18-6-6 6-6"/></svg>
        </span>
        <span class="sr-only">Previous</span>
    </button>
    <button
        type="button"
        class="{{ next_classes }}"
        aria-label="Next"
    >
        <span class="text-2xl" aria-hidden="true">
            <svg class="{{ icon_size }}" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6 6-6"/></svg>
        </span>
        <span class="sr-only">Next</span>
    </button>
{% endif %}

{% if pagination != 'none' and items_count > 0 %}
    {% if variant == 'slideshow' %}
        <div class="hs-carousel-pagination flex justify-center items-center gap-x-2 absolute bottom-5 start-0 end-0 z-20">
            {% for i in 1..items_count %}
                {% if pagination == 'lines' %}
                    <span class="hs-carousel-active:bg-white hs-carousel-active:w-8 w-4 h-1 bg-white/50 rounded-full cursor-pointer transition-all duration-300"></span>
                {% else %}
                    <span class="hs-carousel-active:bg-primary-500 hs-carousel-active:scale-125 size-2.5 bg-white/60 rounded-full cursor-pointer transition-all duration-300"></span>
                {% endif %}
            {% endfor %}
        </div>
    {% else %}
        <div class="hs-carousel-pagination flex justify-center items-center gap-x-2 {% if pagination == 'inside' %}absolute bottom-3 start-0 end-0 z-10{% else %}mt-4{% endif %}">
            {% for i in 1..items_count %}
                <span class="hs-carousel-active:bg-primary hs-carousel-active:border-primary size-2.5 border border-line-4 rounded-full cursor-pointer transition-colors"></span>
            {% endfor %}
        </div>
    {% endif %}
{% endif %}
