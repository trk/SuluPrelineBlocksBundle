<script>
    (function() {
        var scope = document.getElementById('{{ scope_id }}');
        if (!scope) return;
        var bar = scope.querySelector('[data-filter-active-class]');
        var activeClasses = (bar ? bar.getAttribute('data-filter-active-class') : 'bg-primary text-primary-foreground hover:bg-primary-hover border-transparent active').split(' ').filter(Boolean);
        var inactiveClasses = (bar ? bar.getAttribute('data-filter-inactive-class') : 'bg-layer text-layer-foreground border-layer-line hover:bg-layer-hover').split(' ').filter(Boolean);
        var btns = scope.querySelectorAll('.filter-btn');
        var items = scope.querySelectorAll('{{ item_selector|default(".grid-item-card") }}');

        btns.forEach(function(btn) {
            btn.addEventListener('click', function() {
                var filter = this.getAttribute('data-filter');

                btns.forEach(function(b) {
                    activeClasses.forEach(function(c) { b.classList.remove(c); });
                    inactiveClasses.forEach(function(c) { b.classList.add(c); });
                });

                inactiveClasses.forEach(function(c) { btn.classList.remove(c); });
                activeClasses.forEach(function(c) { btn.classList.add(c); });

                items.forEach(function(item) {
                    var tags = (item.getAttribute('data-tags') || '').split(' ');
                    if (filter === '*' || tags.indexOf(filter) !== -1) {
                        item.style.display = '';
                        item.style.opacity = '1';
                    } else {
                        item.style.display = 'none';
                        item.style.opacity = '0';
                    }
                });

                if (typeof window.HSStaticMethods !== 'undefined') {
                    window.HSStaticMethods.autoInit();
                }
            });
        });
    })();
</script>
