<twig:Column
    title="{{ block.title|default(null) }}"
    subtitle="{{ block.subtitle|default(block.meta|default(null)) }}"
    content="{{ block.content|default(null) }}"
    :image="block.image|default(null)"
    :link="block.link|default(null)"
    link_title="{{ block.link_title|default(null) }}"
    col_span="{{ block.col_span|default('12') }}"
    style="{{ block.style|default('card') }}"
    padding="{{ block.padding|default('md') }}"
    vertical_align="{{ block.vertical_align|default('top') }}"
    text_align="{{ block.text_align|default('start') }}"
    :is_sticky="block.is_sticky|default(false)"
    order="{{ block.order|default('default') }}"
    :props="block|merge(block.props|default({}))"
/>
