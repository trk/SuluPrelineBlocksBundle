{% set block = block|block_transform(_context) %}
{% if block %}
<twig:Quotation
    content="{{ block.content|default('') }}"
    author="{{ block.author|default(null) }}"
    authorTitle="{{ block.author_title|default(null) }}"
    :image="block.image|default(null)"
    :link="block.link|default(null)"
    :props="block|merge(block.props|default({}))"
/>
{% endif %}
